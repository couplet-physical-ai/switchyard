# Switchyard server: site configuration. Every value below is a neutral placeholder.
# Copy to server/.env (gitignored) and point the server at it for a local run:
#   SWITCHYARD_ENV_FILE=.env cargo run --release -- --auth open
# A deployed server gets these from its platform's environment instead (the deploy wrapper
# carries the real values; secrets come from its secret store, never from a file in git).
# Unset site keys turn the adapter that needs them off; /api/v1/meta lists each adapter's state
# and the boot log names the missing keys.

# --- what to watch ---------------------------------------------------------------------
# GitHub orgs, comma list, in display order (the first is polled every 45 s, the rest 90 s).
SWITCHYARD_ORGS=acme-labs,acme-platform
# Lowercase substrings of the site's own bot logins that carry no [bot] / -bot mark.
SWITCHYARD_BOT_LOGINS=

# --- upstreams --------------------------------------------------------------------------
# Woodpecker (Roadrunner) API + event stream; the public URL is the one links open
# (defaults to WOODPECKER_URL).
WOODPECKER_URL=https://ci.example.com
WOODPECKER_PUBLIC_URL=https://ci.example.com
# The Roadrunner console (lanes, deploy verdicts, Dagger traces); its /engine page shows
# the machine named CICD_ENGINE_HOST.
CICD_URL=https://cicd.example.com
CICD_ENGINE_HOST=build-host-1
# The apps platform's catalog (app inventory + health).
APPS_CATALOG_URL=https://catalog.example.com/api/apps
# GitHub (defaults shown).
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# --- secrets (never commit real ones) -----------------------------------------------------
WOODPECKER_TOKEN=
GITHUB_TOKEN=
CICD_READ_TOKEN=
# name:sha256 pairs of read-only service tokens (hashes only).
SWITCHYARD_SERVICE_TOKENS=

# --- serving ------------------------------------------------------------------------------
SWITCHYARD_LISTEN=127.0.0.1:8080
# open = no auth (local); platform = SSO edge + device tokens.
SWITCHYARD_AUTH=open
# Public base URL (connect deep links, Origin checks) and the e-mail domains allowed at the edge.
SWITCHYARD_PUBLIC_URL=https://switchyard.example.com
SWITCHYARD_EMAIL_DOMAINS=example.com

# --- fixture sanitizer (`switchyard-server sanitize`) ---------------------------------------
# Private DNS suffixes (hosts under them move to example.com), org renames real=stand-in,
# and the site's bot markers kept as bots.
SWITCHYARD_SANITIZE_DOMAINS=corp.example
SWITCHYARD_SANITIZE_ORGS=Acme-Private=Northwind-Labs
SWITCHYARD_SANITIZE_BOTS=
