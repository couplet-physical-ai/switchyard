// The recorded fleet (contract/fixtures): one frozen, sanitized snapshot shared by the demo
// server. This checks the real connection and that both legacy schematics still read it.

test "the fixture fleet connects on Live and remains available in Factory and Yard"
  clock data
  tap "now-setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock data
  expect state conn.ok == true
  expect state ov.repos == 394
  expect state nowData.ok == true
  expect text "now-status" == "now"
  expect tree missing "now-setup"

  tap "tab-factory"
  clock settle
  clock +1500 real
  clock data
  expect state here == "factory"
  expect tree has "factory-floor"
  expect tree has "factory-live"
  expect tree has "timebar"
  expect state ov.facCity == 240

  tap "tab-yard"
  clock settle
  expect state here == "yard"
  expect tree has "yard-live"
  expect tree has "timebar"
  expect state ov.repos == 394

test "a Live deep link retains its selected repo filter"
  clock data
  tap "now-setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock data
  type "root" "/?repo=copper-browser%2Fvivid-harbor"
  clock settle
  expect state here == "now"
  expect state nowRepo == "copper-browser/vivid-harbor"
  expect state nowData.ok == true
