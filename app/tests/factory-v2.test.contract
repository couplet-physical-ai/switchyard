// The square swarm at /factory?v=2 (the Factory is the berth board; the old floor at ?v=1) (ZERO.md "FACTORY REDO"; views/flow.contract, src/flowfloor/): one fixed floor
// that fits the window, the work flowing left to right, the FAILED bin, the inspector. A press
// on the floor is a real pointer gesture at a point in the canvas (`drag 1 0 from x y` presses,
// moves one point and lets go: a click). The point is the recorded fleet's (contract/fixtures,
// frozen) at 1440×900: the app logs it (`flow: newest failed crate … at x,y`).

size 1440x900

test "swarm: the Factory route keeps a floor behind the setup card"
  clock data
  type "root" "/factory?v=2"
  clock settle
  expect state here == "factory"
  expect tree has "factory-floor"
  expect tree has "factory-live"
  expect tree has "setup"
  expect tree missing "fl-inspector"
  expect text "tab-factory" == "Factory"

test "swarm: the demo fills the floor; the failed bin's window starts at 30 minutes"
  clock data
  type "root" "/factory?v=2"
  clock settle
  tap "setup-demo"
  clock data
  clock +1000
  clock +1500 real
  expect tree missing "setup"
  expect state here == "factory"
  expect state ov.status == "ready"
  expect state flWin == "30m"
  expect state flSel == ""
  expect tree has "replay"
  expect tree has "replay-day"

test "swarm: the recorded real fleet fills the floor"
  clock data
  type "root" "/factory?v=2"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  expect state conn.ok == true
  expect state ov.repos == 394
  expect tree missing "fl-inspector"

test "swarm: the tabs reach Yard and Factory; a Live deep link leaves the Factory"
  clock data
  type "root" "/factory?v=2"
  clock settle
  tap "setup-demo"
  clock data
  tap "tab-yard"
  clock settle
  expect state here == "yard"
  expect tree has "yard-live"
  tap "tab-factory"
  clock settle
  clock +500
  clock +1000 real
  expect state here == "factory"
  expect tree has "factory-live"
  type "root" "/?repo=Northwind-Labs%2Fcicd"
  clock settle
  expect state here == "now"
  expect state nowRepo == "Northwind-Labs/cicd"
