// Live is the default route, with Factory and Yard one click away. Every test starts from the
// built-in demo (no network), so it runs the same on every host.

test "a fresh install asks where to connect, and the demo starts at once"
  clock data
  expect state here == "now"
  expect tree has "now-setup"
  tap "now-setup-demo"
  clock data
  clock +1000
  clock data
  expect tree missing "now-setup"
  expect text "now-status" == "now"
  expect state conn.kind == "demo"
  expect state ov.mode == "live"
  expect state ov.repos == 410

test "the three tabs open Live, Factory and Yard in order"
  clock data
  tap "now-setup-demo"
  clock data
  expect text "tab-now" == "Live"
  expect text "tab-factory" == "Factory"
  expect text "tab-yard" == "Yard"
  tap "tab-factory"
  clock settle
  expect state here == "factory"
  expect tree has "factory-live"
  expect tree has "timebar"
  tap "tab-yard"
  clock settle
  expect state here == "yard"
  expect tree has "yard-live"
  expect tree has "timebar"
  tap "tab-now"
  clock settle
  expect state here == "now"
  expect tree has "now"

test "deep links filter Live by repo, app and commit"
  clock data
  tap "now-setup-demo"
  clock data
  type "root" "/?repo=Northwind-Labs%2Fcicd"
  clock settle
  expect state here == "now"
  expect state nowRepo == "Northwind-Labs/cicd"
  type "root" "/?app=web%2Fswitchyard&sha=Northwind-Labs%2Fcicd%40abc123"
  clock settle
  expect state nowRepo == ""
  expect state nowApp == "web/switchyard"
  expect state nowSha == "Northwind-Labs/cicd@abc123"
