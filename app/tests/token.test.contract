// The token (fx-kc; README "Security"): read once, async, through the app's module (the web's
// page module keeps it in localStorage; macOS a 0600 file, modules/apple/Keychain.swift), so
// nothing at boot waits on it. The ?keychain=denied route is the agent's test hook: one read
// answers denied, as macOS's Deny does.

test "the token loads asynchronously and the floor never waits on it"
  clock data
  clock settle
  expect state tok.status == "none"
  expect state tok.has == false
  expect state tokCard == false
  expect tree missing "tok-card"
  expect tree has "setup-demo"
  tap "setup-demo"
  clock data
  expect state conn.ok == true
  expect state tok.status == "none"

test "a token set in Settings is still there after a reload, and still connects"
  clock data
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  type "token-field" "syd_kcTESTtoken0123456789"
  tap "settings-save"
  clock data
  clock settle
  expect state tok.status == "ready"
  expect state tok.has == true
  expect state conn.ok == true
  expect state conn.kind == "http"
  reload
  clock data
  clock settle
  expect state server == "fixtures"
  expect state tok.status == "ready"
  expect state tok.has == true
  expect state conn.ok == true
  expect state conn.kind == "http"
  expect tree missing "tok-card"

test "a denied read shows the card; Try again reads again"
  clock data
  type "root" "/?keychain=denied"
  clock data
  clock settle
  expect state tok.status == "denied"
  expect state tokCard == true
  expect tree has "tok-card"
  expect text "tok-title" == "Keychain access was denied"
  expect tree has "tok-retry"
  expect tree has "tok-enter"
  expect tree missing "setup"
  tap "tok-retry"
  clock data
  clock settle
  expect state tok.status == "none"
  expect tree missing "tok-card"
  expect tree has "setup"

test "a denied read's Enter token opens Settings, and a saved token connects"
  clock data
  type "root" "/?keychain=denied"
  clock data
  clock settle
  expect text "tok-title" == "Keychain access was denied"
  tap "tok-enter"
  clock settle
  type "server-field" "fixtures"
  type "token-field" "syd_kcTESTtoken0123456789"
  tap "settings-save"
  clock data
  clock settle
  expect state tok.status == "ready"
  expect state tok.has == true
  expect state conn.ok == true
  expect tree missing "tok-card"

test "Forget token signs out: the token is gone, after a reload too"
  clock data
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  type "token-field" "syd_kcTESTtoken0123456789"
  tap "settings-save"
  clock data
  clock settle
  expect state tok.has == true
  tap "open-settings"
  clock settle
  expect tree has "settings-forget"
  expect tree missing "settings-security"
  tap "settings-forget"
  clock data
  clock settle
  expect state tok.has == false
  expect state tok.status == "none"
  expect state tok.left == false
  expect state conn.ok == true
  reload
  clock data
  clock settle
  expect state tok.has == false
  expect state tok.status == "none"

test "an old Keychain item left behind: Settings says how to remove it"
  clock data
  type "root" "/?keychain=left"
  clock data
  clock settle
  expect state tok.left == true
  expect state tokCard == false
  tap "setup-connect"
  clock settle
  expect tree has "settings-security"
  expect text "settings-security-note" == "An old Switchyard token remains in your login Keychain; remove it in Keychain Access → search 'switchyard'."
