// The Factory: "the berth board", at /factory (FACTORY3.md; views/factory3.contract,
// src/factory3/): six stations in flow order, the ledger of events under them, the FAILED bin's
// window, the inspector docked over the ledger. /factory?v=<anything> is the board too: the
// two older floors (?v=1, ?v=2) were retired and their deep links land on it.
// A press on the board is a real pointer gesture at a point in the canvas (`drag 1 0 from x y`
// presses, moves one point and lets go: a click). The points are the recorded fleet's
// (contract/fixtures, frozen) at 1440×900; the app logs them (`factory3: newest failed … x,y`,
// `factory3: window 2h at x,y`, `factory3: newest red … x,y`).
// Stillness: tools/factory3.test.ts proves it on the draw list (a fleet with no work running
// gives the same frame from one second to the next, and nothing in transit); here the moving
// layer is read through `f3S` (how many transits the board ever started, how often the moving
// layer painted).

size 1440x900

test "board: the Factory keeps a board behind the setup card"
  clock data
  type "root" "/factory"
  clock settle
  expect state here == "factory"
  expect state facV3 == true
  expect tree has "factory-floor"
  expect tree has "factory-live"
  expect tree has "factory-moving"
  expect tree has "setup"
  expect tree missing "f3-inspector"
  expect text "tab-factory" == "Factory"

// the retired floors' deep links land on the board, on every host
test "board: /factory?v=1, ?v=2 and ?v=3 are the board"
  clock data
  type "root" "/factory?v=1"
  clock settle
  expect state facV3 == true
  expect tree has "factory-moving"
  type "root" "/factory?v=2"
  clock settle
  expect state facV3 == true
  expect tree has "factory-moving"
  type "root" "/factory?v=3"
  clock settle
  expect state facV3 == true
  expect tree has "factory-moving"

test "board: the demo fills it; the failed bin's window starts at 30 minutes"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-demo"
  clock data
  clock +1000
  clock +1500 real
  expect tree missing "setup"
  expect state ov.status == "ready"
  expect state f3Win == "30m"
  expect state f3Sel == ""
  expect tree has "replay"
  expect tree missing "f3-inspector"

test "board: on a fleet where nothing changes, nothing ever travels"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  expect state conn.ok == true
  expect state ov.repos == 394
  clock +4000
  clock +1500 real
  // no transit was ever started and the moving layer never painted
  expect state f3S.status == "transits=0 live=0"

test "board: paused, no pixel changes"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  tap "pause"
  clock data
  clock +2000
  clock +1000 real
  // nothing shown ticks: the pulse stopped (no clock, no source asked, nothing redrawn)
  expect state ov.pace == 2
  // the HUD's numbers (asked 4 times a second while it shows): "ok" = neither canvas was
  // painted for two seconds
  tap "hud-toggle"
  clock data
  clock +3000
  clock +2000 real
  expect state f3S.ok == true
  expect state f3S.status == "transits=0 live=0"

test "board: a press on the bin's newest failure opens the inspector; Escape closes it"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  tap "factory-live" drag 1 0 from 679 210 mouse
  clock data
  clock +500
  expect state f3Kind == "run"
  expect state f3Dock == true
  expect state f3D.kind == "run"
  expect state f3D.state == "fail"
  expect state f3D.logFail == true
  expect tree has "f3-inspector"
  expect tree has "f3-link-rr"
  expect tree has "f3-link-commit"
  type "factory" key "Escape"
  clock data
  expect state f3Sel == ""
  expect tree missing "f3-inspector"

test "board: the same press again closes; close closes"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  tap "factory-live" drag 1 0 from 679 210 mouse
  clock data
  clock +500
  expect tree has "f3-inspector"
  tap "factory-live" drag 1 0 from 679 210 mouse
  clock data
  clock +500
  expect state f3Sel == ""
  expect tree missing "f3-inspector"
  tap "factory-live" drag 1 0 from 679 210 mouse
  clock data
  clock +500
  expect tree has "f3-inspector"
  tap "f3-close"
  clock data
  expect tree missing "f3-inspector"

test "board: a window chip sets the failed bin's window"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  expect state f3Win == "30m"
  tap "factory-live" drag 1 0 from 729 180 mouse
  clock data
  clock +500
  expect state f3Win == "2h"
  expect state f3Sel == ""

test "board: a red main line opens as a main line, with its links"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-connect"
  clock settle
  type "server-field" "fixtures"
  tap "settings-save"
  clock data
  clock +1000
  clock +1500 real
  tap "factory-live" drag 1 0 from 899 133 mouse
  clock data
  clock +500
  expect state f3Kind == "repo"
  expect state f3Sel == "Northwind-Labs/hollow-relay"
  expect state f3D.state == "fail"
  expect text "f3-name" == "hollow-relay"
  expect tree has "f3-link-github"

test "board: the tabs leave and come back; a Live deep link leaves the Factory"
  clock data
  type "root" "/factory"
  clock settle
  tap "setup-demo"
  clock data
  tap "tab-yard"
  clock settle
  expect state here == "yard"
  expect tree has "yard-live"
  type "root" "/factory"
  clock settle
  clock +500
  clock +1000 real
  expect state here == "factory"
  expect tree has "factory-moving"
  type "root" "/?repo=Northwind-Labs%2Fcicd"
  clock settle
  expect state here == "now"
