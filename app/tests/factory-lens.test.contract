// The factory's click grammar and coffee check (src/factory/lens.ts, coffee.ts; fab-lens). A test
// cannot press a canvas at a point, so these drive the floor's keys and read what it answers:
// the key ("?"), the lens stack's walk back (Esc), and the last visit kept per server.

test "the coffee check reads the floor and keeps the last visit"
  clock data
  tap "setup-demo"
  clock data
  clock +500
  expect state coffee.ok == true
  expect state visitN == 0
  clock +20000
  clock +101000
  clock data
  expect state visitN == 1
  expect state looking == true

test "leaving the floor marks the visit"
  clock data
  tap "setup-demo"
  clock data
  clock +21000
  expect state looking == true
  tap "tab-fleet"
  clock settle
  clock +500
  clock data
  expect state looking == false
  expect state visitN == 1

test "? shows the key and Esc puts it away"
  clock data
  tap "setup-demo"
  clock data
  clock +500
  type "factory" key "?"
  clock data
  expect state facNow.kind == "legend"
  type "factory" key "Escape"
  clock data
  expect state facNow.kind == "lens"
  expect state facNow.id == "0"

// fab-w3: the return conveyor parks failures by cluster, the biggest open one nearest the scanner,
// so its first crate is always at the same spot on the fitted floor (u 1082, v 626 at 1440x900).
test "a parked failure opens its cluster lens and Escape walks back"
  clock data
  tap "setup-demo"
  clock data
  clock +1000
  clock +1500 real
  tap "factory-live" drag 1 0 from 904 677 mouse
  clock data
  clock +300
  expect state facNow.kind == "failure"
  expect state ov.facLens == 1
  type "factory-live" key "Escape"
  clock data
  clock +300
  expect state ov.facLens == 0
  expect state facNow.kind == "lens"

test "shift-click compares two groups in the dock, Escape puts it away"
  clock data
  tap "setup-demo"
  clock data
  clock +1000
  clock +1500 real
  tap "factory-live" drag 1 0 from 312 197 mouse
  clock data
  clock +300
  expect state ov.facLens == 1
  type "factory-live" key "Shift" down
  tap "factory-live" drag 1 0 from 283 251 mouse
  type "factory-live" key "Shift" up
  clock data
  clock +300
  expect state facNow.kind == "compare"
  expect state ov.facLens == 1
  type "factory-live" key "Escape"
  clock data
  clock +300
  expect state facNow.kind == "lens"
  expect state facNow.id == "1"
  type "factory-live" key "Escape"
  clock data
  clock +300
  expect state ov.facLens == 0
