// The factory's click grammar (src/factory/lens.ts; fab-lens). A test cannot press a canvas at a
// point, so these drive the floor's keys and read what it answers: the key ("?") and the lens
// stack's walk back (Esc). The coffee check's own: tests/factory-coffee.test.contract.

test "? shows the key and Esc puts it away"
  clock data
  tap "setup-demo"
  clock data
  clock +500
  type "factory" key "?"
  clock data
  expect state facNow.kind == "legend"
  type "factory" key "Escape"
  clock data
  expect state facNow.kind == "lens"
  expect state facNow.id == "0"
