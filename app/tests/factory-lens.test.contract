// The factory's click grammar and coffee check (src/factory/lens.ts, coffee.ts; fab-lens). A test
// cannot press a canvas at a point, so these drive the floor's keys and read what it answers:
// the key ("?"), the lens stack's walk back (Esc), and the last visit kept per server.

test "the coffee check reads the floor and keeps the last visit"
  clock data
  tap "setup-demo"
  clock data
  clock +500
  expect state coffee.ok == true
  expect state visitN == 0
  clock +10000
  clock +111000
  clock data
  expect state visitN == 1
  expect state looking == true

test "leaving the floor marks the visit"
  clock data
  tap "setup-demo"
  clock data
  clock +11000
  expect state looking == true
  tap "tab-fleet"
  clock settle
  clock +500
  clock data
  expect state looking == false
  expect state visitN == 1

test "? shows the key and Esc puts it away"
  clock data
  tap "setup-demo"
  clock data
  clock +500
  type "factory" key "?"
  clock data
  expect state facNow.kind == "legend"
  type "factory" key "Escape"
  clock data
  expect state facNow.kind == "lens"
  expect state facNow.id == "0"
