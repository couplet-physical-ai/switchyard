// ⌘K: one field that routes repo, PR, app, commit and pipeline hits to Live filters.

test "the palette finds a repo and opens its Live filter"
  clock data
  tap "now-setup-demo"
  clock data
  tap "open-palette"
  clock settle
  type "palette-input" "cicd"
  clock +300
  expect tree has "hit-repo-Northwind-Labs/cicd"
  tap "hit-repo-Northwind-Labs/cicd"
  clock settle
  expect state here == "now"
  expect state nowRepo == "Northwind-Labs/cicd"
  expect tree has "now"

test "an empty palette lists what is on fire"
  clock data
  tap "now-setup-demo"
  clock data
  tap "open-palette"
  clock +300
  expect state q == ""
  expect tree missing "palette-empty"
