// A connect link (switchyard://connect?server=…&token=…) asks first, then connects. The
// system hands the app `/connect?u=<the whole URL>`; the web takes `/connect?server=…`.

test "a switchyard:// link asks before it connects"
  clock data
  tap "now-setup-demo"
  clock data
  type "root" "/connect?u=switchyard%3A%2F%2Fconnect%3Fserver%3Dhttps%253A%252F%252Fswitchyard.example.com%26token%3Dsyd_abc123"
  clock settle
  expect tree has "connect"
  expect text "connect-server" == "https://switchyard.example.com"
  expect state link.ok == true
  expect state link.token == "syd_abc123"
  tap "connect-no"
  clock settle
  expect tree missing "connect"

test "a link with a bad server is refused"
  clock data
  tap "now-setup-demo"
  clock data
  type "root" "/connect?server=javascript%3Aalert(1)"
  clock settle
  expect tree has "connect"
  expect state link.ok == false

// The release soak's tab cycle: switchyard://view/<live|factory|yard> switches the tab, no confirm.
test "a switchyard://view link switches the tab and asks nothing"
  clock data
  tap "now-setup-demo"
  clock data
  type "root" "/connect?u=switchyard%3A%2F%2Fview%2Ffactory"
  clock settle
  clock +100
  expect state here == "factory"
  expect tree missing "connect"
  type "root" "/connect?u=switchyard%3A%2F%2Fview%2Fyard"
  clock settle
  clock +100
  expect state here == "yard"
  type "root" "/connect?u=switchyard%3A%2F%2Fview%2Flive"
  clock settle
  clock +100
  expect state here == "now"
  type "root" "/connect?u=switchyard%3A%2F%2Fview%2Fsettings"
  clock settle
  expect tree has "connect"
  expect state link.ok == false
