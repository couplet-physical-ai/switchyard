+    const v = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2];
+    out[o] = C[v >> 18]; out[o + 1] = C[(v >> 12) & 63]; out[o + 2] = C[(v >> 6) & 63]; out[o + 3] = C[v & 63];
+    o += 4;
+  }
+  if (i < n) {
+    const v = (bytes[i] << 16) | ((i + 1 < n ? bytes[i + 1] : 0) << 8);
+    out[o] = C[v >> 18]; out[o + 1] = C[(v >> 12) & 63]; out[o + 2] = i + 1 < n ? C[(v >> 6) & 63] : 61; out[o + 3] = 61;
