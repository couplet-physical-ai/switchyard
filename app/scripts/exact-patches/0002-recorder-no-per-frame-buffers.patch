-    out += B64[n >> 18] + B64[(n >> 12) & 63] + (i + 1 < bytes.length ? B64[(n >> 6) & 63] : "=") + "=";
+// Switchyard patch (app/scripts/exact-patches/0002): base64 into one reused buffer of ASCII codes,
+// turned into strings 4 KB at a time and joined once, with the reply around them. Building it
+// with `out +=` four characters at a time left Hermes's external-memory count higher after every
+// frame (its concatenation buffers), which Hades counts toward the heap cap: a long-lived window
+// drawing every frame ended in GCBase::oom with a flat live set. The reply's bytes are the same.
+const B64_CODES = Array.from(B64, (c) => c.charCodeAt(0));
+const B64_PIECE = 4096;
+let b64Scratch = new Uint8Array(4096);
+/** `bytes` in base64, pushed onto `parts` as strings of at most B64_PIECE characters. */
+function base64Parts(bytes, parts) {
+  const n = bytes.length, size = Math.ceil(n / 3) * 4;
+  if (b64Scratch.length < size) b64Scratch = new Uint8Array(Math.max(size, b64Scratch.length * 2));
+  const out = b64Scratch, C = B64_CODES;
