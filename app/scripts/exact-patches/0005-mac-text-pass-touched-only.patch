diff --git a/host/apple/tests/ExactKitTests/TextTouchedMacTests.swift b/host/apple/tests/ExactKitTests/TextTouchedMacTests.swift
new file mode 100644
index 00000000..7ccb86b1
--- /dev/null
+++ b/host/apple/tests/ExactKitTests/TextTouchedMacTests.swift
@@ -0,0 +1,114 @@
+#if os(macOS)
+import AppKit
+import XCTest
+@testable import ExactKit
+
+/// A batch that only gives text new words (a running timer's second) asks
+/// the text pass only of what it touched (`Presenter.textTouched`,
+/// `textQuiet`). What shows is still the new words' pixels, the paragraphs
+/// it did not touch keep theirs, and a full pass after it finds nothing to do.
+@MainActor
+final class TextTouchedMacTests: XCTestCase {
+    private var window: NSWindow!
+    private var session: ExactSession?
+
+    override func tearDown() { session?.destroy(); session = nil; window?.orderOut(nil); window = nil; super.tearDown() }
+
+    private static let style: [String: Any] = ["font_size": 24.0, "line_height": "30px", "text_color": [0.0, 0.0, 0.0, 255.0]]
+
+    /// A column (1) of two large paragraphs (2, 4: surfaces) and a small label (3).
+    private func fixture() -> Presenter {
+        _ = NSApplication.shared
+        let session = ExactApp.shared.makeSession(label: "text-touched")
+        self.session = session
+        let p = session.presenter
+        window = NSWindow(contentRect: NSRect(x: 40, y: 40, width: 460, height: 260), styleMask: [.borderless], backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        window.backgroundColor = .white
+        window.appearance = NSAppearance(named: .aqua)
+        window.contentView = p.viewport
+        p.apply(wireBatch([
+            ["op": "create", "id": 1, "kind": "view"],
+            ["op": "create", "id": 2, "kind": "text", "props": ["text": "Running 0:01, deploy, step 3 of 5"], "style": Self.style],
+            ["op": "create", "id": 3, "kind": "text", "props": ["text": "0:01"], "style": ["font_size": 11.0, "text_color": [0.0, 0.0, 0.0, 255.0]]],
+            ["op": "create", "id": 4, "kind": "text", "props": ["text": "Waiting 0:07 behind four other builds"], "style": Self.style],
+            ["op": "children", "id": 1, "ids": [2, 3, 4]],
+            ["op": "roots", "ids": [1]],
+            ["op": "frame", "id": 1, "x": 0.0, "y": 0.0, "w": 460.0, "h": 260.0],
+            ["op": "frame", "id": 2, "x": 10.0, "y": 10.0, "w": 440.0, "h": 60.0],
+            ["op": "frame", "id": 3, "x": 10.0, "y": 80.0, "w": 40.0, "h": 16.0],
+            ["op": "frame", "id": 4, "x": 10.0, "y": 110.0, "w": 440.0, "h": 60.0],
+        ]))
+        window.orderFrontRegardless()
+        return p
+    }
+
+    private func settle(_ p: Presenter) {
+        for _ in 0..<3 {
+            window.displayIfNeeded()
+            CATransaction.flush()
+            RunLoop.main.run(until: Date(timeIntervalSinceNow: 0.1))
+        }
+    }
+
+    private func words(_ node: NodeView) -> String? { node.textRasterKey?.spec.runs.map(\.text).joined() }
+
+    func testAWordsOnlyBatchShowsTheNewWordsAndLeavesTheRestAsAFullPassWould() throws {
+        let p = fixture()
+        settle(p)
+        let running = try XCTUnwrap(p.views[2]), label = try XCTUnwrap(p.views[3]), waiting = try XCTUnwrap(p.views[4])
+        guard running.rastersText, waiting.rastersText else { throw XCTSkip("the paragraphs are drawn here, not rasterized (scale \(running.pixelScale ?? 0))") }
+        XCTAssertFalse(label.rastersText, "a small label draws")
+        XCTAssertEqual(words(running), "Running 0:01, deploy, step 3 of 5")
+        let kept = try XCTUnwrap(waiting.textRaster)
+        let index = TextViewportIndex(p.selection.shownParagraphs)
+        XCTAssertTrue(index.unmoved)
+
+        for second in 2...4 {
+            p.apply(wireBatch([
+                ["op": "props", "id": 2, "set": ["text": "Running 0:0\(second), deploy, step 3 of 5"]],
+                ["op": "props", "id": 3, "set": ["text": "0:0\(second)"]],
+            ]))
+            settle(p)
+            XCTAssertEqual(words(running), "Running 0:0\(second), deploy, step 3 of 5", "the surface shows the batch's words")
+            XCTAssertTrue(running.textRasterReady)
+            XCTAssertFalse(running.needsTextRaster)
+            XCTAssertEqual(label.paragraphSpec().runs.map(\.text).joined(), "0:0\(second)")
+            XCTAssertTrue(waiting.textRaster === kept, "an untouched paragraph keeps its pixels")
+            XCTAssertTrue(index.unmoved, "words move no box")
+            // The full pass the batch no longer runs has nothing left to do.
+            XCTAssertFalse(p.refreshVisibleText())
+            XCTAssertTrue(waiting.textRaster === kept)
+            XCTAssertEqual(words(running), "Running 0:0\(second), deploy, step 3 of 5")
+        }
+    }
+
+    func testAMoveOrAScaleMakesTheIndexStaleAndTheNextPassFull() throws {
+        let p = fixture()
+        settle(p)
+        let waiting = try XCTUnwrap(p.views[4])
+        let index = TextViewportIndex(p.selection.shownParagraphs)
+        XCTAssertTrue(index.unmoved)
+        // A box moved: the paragraph's place in the document changed.
+        p.apply(wireBatch([["op": "frame", "id": 4, "x": 10.0, "y": 180.0, "w": 440.0, "h": 60.0]]))
+        XCTAssertFalse(index.unmoved)
+        settle(p)
+        // Words after the move: the paragraph that moved still shows the new words where it is.
+        p.apply(wireBatch([["op": "props", "id": 4, "set": ["text": "Waiting 0:08 behind four other builds"]]]))
+        settle(p)
+        if waiting.rastersText {
+            XCTAssertEqual(words(waiting), "Waiting 0:08 behind four other builds")
+            XCTAssertEqual(waiting.textRasterKey?.size, waiting.bounds.size)
+        }
+        // A page zoom changes the document's device pixels: stale too.
+        let zoomed = TextViewportIndex(p.selection.shownParagraphs)
+        XCTAssertTrue(zoomed.unmoved)
+        session?.pageZoom = 1.25
+        XCTAssertFalse(zoomed.unmoved)
+        // Mounting a box is a move.
+        let mounted = TextViewportIndex(p.selection.shownParagraphs)
+        p.apply(wireBatch([["op": "create", "id": 5, "kind": "text", "props": ["text": "new"], "style": Self.style], ["op": "children", "id": 1, "ids": [2, 3, 4, 5]]]))
+        XCTAssertFalse(mounted.unmoved)
+    }
+}
+#endif
