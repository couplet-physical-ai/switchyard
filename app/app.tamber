tamber switchyard

// One world, always dark (DESIGN.md, "Colour"): every token is fixed on purpose.
theme
  AccentColor = #FF7212  scheme=fixed
  sy.canvas = #0E0E0E  scheme=fixed
  sy.raised = #151516  scheme=fixed
  sy.control = #1C1C1E  scheme=fixed
  sy.control-on = #2C2C2E  scheme=fixed
  sy.rule = #1F1F1F  scheme=fixed
  sy.edge = #2E2E30  scheme=fixed
  sy.machine = #58585A  scheme=fixed
  sy.ink = #F2F2F0  scheme=fixed  pair=sy.canvas
  sy.ink2 = #A3A3A3  scheme=fixed  pair=sy.canvas
  sy.ink3 = #8A8A8A  scheme=fixed  pair=sy.canvas
  sy.ink4 = #6A6A6A  scheme=fixed
  sy.amber = #E5B567  scheme=fixed  pair=sy.canvas
  sy.amber-text = #D8BA92  scheme=fixed  pair=sy.canvas
  sy.green = #7FC48F  scheme=fixed  pair=sy.canvas
  sy.green-fill = #1F2822  scheme=fixed
  sy.green-edge = #3C5443  scheme=fixed
  sy.green-ink = #9CC3A6  scheme=fixed  pair=sy.green-fill
  sy.red = #E06464  scheme=fixed  pair=sy.canvas
  sy.red-text = #E3858C  scheme=fixed  pair=sy.canvas
  sy.red-fill = #2B1A1C  scheme=fixed
  sy.red-edge = #6B3A3F  scheme=fixed
  sy.chip-edge = #3E3E40  scheme=fixed
  sy.brand = #FF7212  scheme=fixed
  sy.up = #5A6E5F  scheme=fixed
  // Live view (ZERO.md): neutral surfaces; colour only for state (running, failed), both schemes
  zr.bg = light-dark(#FFFFFF, #0B0B0C)
  zr.raise = light-dark(#F3F4F6, #141416)
  zr.rule = light-dark(#E2E4E9, #222226)
  zr.rule2 = light-dark(#CDD0D5, #303035)
  zr.ink = light-dark(#150101, #F2F2F0)  pair=zr.bg
  zr.ink2 = light-dark(#4A505C, #ADADB2)  pair=zr.bg
  zr.ink3 = light-dark(#646A78, #85858B)  pair=zr.bg
  zr.ink4 = light-dark(#A0A6B1, #4E4E54)
  zr.run = light-dark(#B93F08, #FF7A1F)  pair=zr.bg
  zr.fail = light-dark(#C41010, #FF5C5C)  pair=zr.bg
  zr.track = light-dark(#E6E8EC, #26262B)
  zr.fill = light-dark(#6B7180, #9A9AA0)
