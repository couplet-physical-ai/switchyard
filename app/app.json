{
  "$schema": "../../../exact/scripts/app.schema.json",
  "name": "Switchyard",
  "short_name": "Switchyard",
  "id": "com.exowatt.switchyard",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.exowatt.switchyard",
    "name": "Switchyard"
  },
  "host": {
    "web": {},
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    }
  },
  "moduleConfig": {
    "updater": {
      "repo": "couplet-physical-ai/switchyard"
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0"
    }
  },
  "commands": {
    "server": [
      "bun",
      "server/mock.ts",
      "--fixtures",
      "../contract/fixtures",
      "--frozen"
    ]
  },
  "server": {
    "database": false
  },
  "protocol_handlers": [
    {
      "protocol": "switchyard",
      "url": "/connect?u=%s"
    }
  ],
  "env": [
    "SWITCHYARD_DEFAULT_SERVER",
    "SWITCHYARD_WEB_SHA"
  ]
}
