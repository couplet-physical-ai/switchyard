// Data shapes shared by the Live, Factory and Yard views.

shape Media
  prefersReducedMotion: bool

shape Time
  epochAtZero: number
  utcOffset: number

shape Tok
  ver: string
  has: bool
  // fx-kc: how the one async read went: "loading" | "ready" | "none" | "denied" | "error"
  status: string
  detail: string
  // the old Keychain item may still be there (macOS let only the build that made it delete it)
  left: bool

shape Link
  server: string
  token: string
  ok: bool

shape Conn
  ok: bool
  status: string
  error: string
  seq: number
  label: string
  kind: string
  needsSetup: bool
  signIn: string

shape Ack
  ok: bool
  status: string

// The live stream (app.ts `liveFeed`): `wake` moves when frames wait for a clock to be taken in
// at (the pulse is asleep or slow): Contract ticks once for them (app.contract `fed`).
shape Feed
  ok: bool
  status: string
  wake: number

shape Hit
  kind: string
  id: string
  label: string
  route: string

shape Overview
  status: string
  mode: string
  speed: number
  sentence: string
  summary: string
  layoutKey: string
  repos: number
  building: number
  queued: number
  red: number
  appsUp: number
  appsTotal: number
  // fx-glance: apps down, and the coffee header's totals as drawn (tests/factory-coffee)
  appsDown: number
  facHead: string
  behind: string
  seq: number
  // the canvases' redraw key: moves only when what they show changed (app.ts `redraw`)
  tick: number
  // the pulse: 0 every 250 ms (something moves or plays), 1 every second (a shown timer runs;
  // the second is a key only: nothing is asked for it but what shows a timer), 2 none (idle)
  pace: number
  // the next wake (seconds; 1-32, a ladder to the minute's turn) and its key (re-arms it)
  wake: number
  wakeKey: number
  host: string
  dial: string
  dialPad: number
  dialFont: number
  dialH: number
  hud: bool
  stress: bool
  quality: number
  facKey: string
  facDrawer: bool
  facQ: number
  facStress: bool
  facCalm: bool
  facStats: string
  facCity: number
  facCars: number
  facBays: number
  facLens: number
  facLensTop: string

shape SearchHit
  kind: string
  id: string
  title: string
  subtitle: string
  route: string

shape Found
  hits: SearchHit[]

shape WebVer
  stale: bool
  served: string
