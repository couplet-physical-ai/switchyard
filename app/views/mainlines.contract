// Mainlines: every repo's default branch as one row of a canvas table (DESIGN.md, "Views").
// ONE canvas draws the rows in view (src/table/), however many repos there are; this file is
// the header around it and the state the canvas is drawn from (focus, wheel, pointer).

use Mainlines, Hit, Ack from "./shapes.contract"

members App
  state mlOrg = ""
  state mlFilter = ""
  state mlQ = ""
  // A focus picked here wins over the deep link it was picked under (`?repo=`); a new link wins.
  state mlPicked = ""
  state mlOwn = false
  state mlLink = ""
  state mlWheel = 0
  state mlPx = -1
  state mlPy = -1
  state mlKick = 0
  // Which view is on top: the data module stops drawing the yard's live layer while it is
  // covered (the stack keeps the yard mounted under every other view).
  resource syTop = viewOnTop(here) as shape Ack else empty(ok=false, status="")
  derive mlFocus = (mlOwn and mlLink == searchParam(top(nav), "repo")) ? mlPicked : searchParam(top(nav), "repo")
  resource mlData = mainlines(here == "mainlines" ? clockMs : 0, mlOrg, mlFilter, mlQ, mlFocus) as shape Mainlines else empty(total=0, red=0, building=0, shown=0, tick=0, top="", atEnd=false, focusText="", focusShown=false, summary="")
  mutation mlHit as shape Hit then mlAfterHit
  mutation mlNav as shape Hit then mlAfterNav
  derive mlHitNow = match mlHit { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  derive mlNavNow = match mlNav { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  action mlPickOrg(o: string)
    mlOrg = o
  action mlPickFilter(f: string)
    mlFilter = f
  action mlTyped(v: string)
    mlQ = v
  action mlFocusOn(id: string)
    mlPicked = id
    mlOwn = true
    mlLink = searchParam(top(nav), "repo")
  // A press picks the row under it: the first focuses it, a press on the focused row opens it.
  action mlPress(e: PointerEvent)
    send mlHit = tablePick("mainlines", e.offsetX, e.offsetY)
  action mlAfterHit
    if mlHitNow.kind == "row"
      if mlHitNow.id == mlFocus
        if mlHitNow.route != ""
          nav = go(nav, mlHitNow.route)
      else
        mlFocusOn(mlHitNow.id)
    else if mlHitNow.route != ""
      nav = go(nav, mlHitNow.route)
  action mlMove(e: PointerEvent)
    mlPx = e.offsetX
    mlPy = e.offsetY
  action mlHover(on: bool)
    if not on
      mlPx = -1
      mlPy = -1
  action mlWheeled(e: WheelEvent)
    mlWheel = mlWheel + e.deltaY
    preventDefault()
  action mlKey(k: string)
    send mlNav = tableKey("mainlines", k)
  action mlAfterNav
    mlKick = mlKick + 1
    if mlNavNow.kind == "focus"
      mlFocusOn(mlNavNow.id)
    else if mlNavNow.kind == "open" and mlNavNow.route != ""
      nav = go(nav, mlNavNow.route)

fn orgShort(o: string): string = o == "" ? "all" : (o == "Northwind-Labs" ? "labs" : (o == "Northwind-EMS" ? "ems" : (o == "Northwind-Forge" ? "forge" : (o == "couplet-physical-ai" ? "couplet" : (o == "copper-browser" ? "copper" : o)))))

component MainlinesView
  props
    data: Mainlines
    org: string
    filter: string
    q: string
    focus: string
    wheel: number
    px: number
    py: number
    kick: number
    active: bool
    pickOrg: action
    pickFilter: action
    typed: action
    press: action
    move: action
    hover: action
    wheeled: action
    key: action
  view
    column flex=1 min-height=0 testId="mainlines"
      header appearance="none" display="flex" align-items="center" gap=12 padding="8px 16px" flex-wrap="wrap" border-bottom="1px solid sy.rule"
        row gap=10 align-items="baseline" flex="1 1 360px" min-width=0
          text "Main lines" role="heading" aria-level=2 font-weight=700 font-size=14
          text (data.shown == data.total ? `${data.total} ${data.total == 1 ? "repo" : "repos"} · ${data.red} red · ${data.building} building` : `${data.shown} of ${data.total} ${data.total == 1 ? "repo" : "repos"} · ${data.red} red · ${data.building} building`) color="sy.ink3" font-size=12 white-space="nowrap" testId="mainlines-count"
          if data.focusText != ""
            text data.focusText color="sy.ink2" font-size=12 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 testId="mainlines-focus"
        row role="radiogroup" aria-label="Organization" gap=2 padding=2 border-radius=7 background-color="sy.control"
          for o in ["", "Northwind-Labs", "Northwind-EMS", "Northwind-Forge", "couplet-physical-ai", "copper-browser"] key=o
            button role="radio" aria-checked=(org == o) press=pickOrg(o) testId=`org-${orgShort(o)}` padding="3px 8px" border-radius=5
              background-color=(org == o ? "sy.control-on" : "transparent")
              text orgShort(o) font-size=11 color=(org == o ? "sy.ink" : "sy.ink3")
        row role="radiogroup" aria-label="State" gap=2 padding=2 border-radius=7 background-color="sy.control"
          for f in ["", "red", "building"] key=f
            button role="radio" aria-checked=(filter == f) press=pickFilter(f) testId=`state-${f == "" ? "all" : f}` padding="3px 8px" border-radius=5
              background-color=(filter == f ? "sy.control-on" : "transparent")
              text (f == "" ? "all" : f) font-size=11 color=(filter == f ? (f == "red" ? "sy.red-text" : "sy.ink") : "sy.ink3")
        input type="search" value=q input=typed aria-label="Filter repos" placeholder="filter repos" testId="mainlines-filter" width=170
          padding="4px 9px" font-size=12 border-radius=7 background-color="sy.raised" border="1px solid sy.edge" color="sy.ink"
          ::placeholder
            color="sy.ink3"
      column flex=1 min-height=0 position="relative"
        if active
          canvas surface=mainlinesTable(data.tick, focus, wheel, px, py, org, filter, q, kick) position="absolute" left=0 top=0 width="100%" height="100%"
            tabindex=0 role="img" aria-label=data.summary touch-action="none" testId="mainlines-table"
            pointerdown=press pointermove=move hover=hover wheel=wheeled key=key
