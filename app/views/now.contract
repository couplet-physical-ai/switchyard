// LIVE: the primary view (ZERO.md; Felipe picked concept A, 2026-11-11). One vertical,
// time-ordered feed that reads as a sentence: an EVENT (push, PR, tag, cron, manual) → every job
// it started, WHERE (CI, machine, slot), its live step and timer → HOW IT ENDED (passed, failed at
// a step with the error line, a deploy → the app → its health). On top: what needs a human. Then
// what runs right now, then what just finished (15 min), then earlier (2 h), dimmer.
//
// Look (Felipe's hard rule): neutral surfaces and grey 1-px hairlines; no coloured borders, rails
// or tinted boxes. Colour is state only, on the small glyph and the status word or timer:
// orange = running, red = failed / broken. Typography and alignment do the rest.
// src/now/view.ts builds every line (words already cut at token bounds, links from server data).

keyframes nowBeat
  from opacity=1
  to opacity=0.3

// the Yard's live step: its frame breathes
keyframes nowHot
  from opacity=1
  to opacity=0.55
// a chain arrives (a new event, a job that started; a finished one sliding into "just finished")
keyframes nowIn
  from opacity=0 translate="0px -6px"
// a chain that ends leaves "now"
keyframes nowOut
  to opacity=0 translate="0px 8px" animation-timing-function="ease-in"

shape NowLink
  id: string
  label: string
  url: string

shape NowCell
  id: string
  on: bool
  pct: number
  known: bool

shape NowChip
  id: string
  text: string
  st: string
  arrow: bool
  hot: bool

shape NowMach
  id: string
  label: string
  text: string
  cells: NowCell[]
  busy: number
  slots: number
  offline: bool
  url: string

shape NowJob
  id: string
  sel: string
  state: string
  tone: string
  glyph: string
  last: bool
  kind: string
  name: string
  where: string
  machine: string
  machineSel: string
  step: string
  pct: number
  hasPct: bool
  over: bool
  timer: string
  usual: string
  result: string
  err: string
  app: string
  health: string
  dur: string
  links: NowLink[]
  chain: NowChip[]
  note: string
  full: string

shape NowChain
  id: string
  glyph: string
  tone: string
  text: string
  app: string
  health: string

shape NowEvent
  id: string
  sel: string
  band: string
  state: string
  tone: string
  glyph: string
  time: string
  ago: string
  kind: string
  repo: string
  repoFull: string
  branch: string
  sha: string
  title: string
  who: string
  bot: bool
  jobs: NowJob[]
  more: string
  chain: NowChain[]
  chainMore: string
  result: string
  links: NowLink[]

shape NowBead
  id: string
  st: string
  cul: bool

shape NowNeed
  id: string
  kind: string
  what: string
  word: string
  detail: string
  ago: string
  links: NowLink[]
  sha: string
  who: string
  beads: NowBead[]

shape NowFeed
  ok: bool
  tick: number
  clock: string
  running: number
  queued: number
  waiting: number
  busy: number
  slots: number
  machines: NowMach[]
  needs: NowNeed[]
  needsN: number
  needsMore: string
  now: NowEvent[]
  just: NowEvent[]
  earlier: NowEvent[]
  intake: string
  idle: bool
  idleText: string
  filtered: bool
  filterText: string
  summary: string

shape NowStep
  id: string
  glyph: string
  tone: string
  name: string
  dur: string
  depth: number
  err: string
  url: string
  cached: bool

shape NowRun
  id: string
  sel: string
  glyph: string
  tone: string
  repo: string
  kind: string
  step: string
  timer: string
  url: string

shape NowPanel
  ok: bool
  kind: string
  id: string
  title: string
  sub: string
  links: NowLink[]
  steps: NowStep[]
  runs: NowRun[]
  empty: string
  logCap: bool
  logStep: string
  logWorkflow: string
  logLive: bool
  logFail: bool

shape NowLogRow
  id: string
  n: string
  text: string
  hot: bool

shape NowLog
  ok: bool
  step: string
  rows: NowLogRow[]
  note: string
  gap: bool

shape NowVp
  width: number

members App
  // The selected job or machine ("job:<id>", "machine:<id>"), "" for none: its detail opens
  // under its line (a machine's under the status line).
  state nowSel = ""
  // A finished event opened to show its jobs ("ev:<id>"), "" for none.
  state nowOpen = ""
  // "Needs a human" shows its first five; this shows them all.
  state nowMore = false
  resource nowVp = exactViewport() as shape NowVp else empty(width=1440)
  derive nowNarrow = nowVp.width > 0 and nowVp.width < 760
  derive nowSec = floor(clockMs / 1000)
  // filters live in the URL (deep-linkable): /?repo=owner/name, /?app=slug, /?sha=owner/name@sha
  derive nowRepo = searchParam(top(nav), "repo")
  derive nowApp = searchParam(top(nav), "app")
  derive nowSha = searchParam(top(nav), "sha")
  resource nowData = nowFeed(here == "now" ? nowSec : 0, nowRepo, nowApp, nowSha) as shape NowFeed else empty()
  resource nowPanelData = nowPanel(nowSel, (here == "now" and nowSel != "") ? nowSec : 0) as shape NowPanel else empty()
  // The log tail: only with the server's capability; every 10 s while its step runs; dropped
  // (an empty selection) when the detail closes.
  resource nowLogData = nowLog(nowSel, nowPanelData.logStep, nowPanelData.logWorkflow, nowPanelData.logLive ? floor(clockMs / 10000) : 0, nowSel.startsWith("job:") and nowPanelData.logCap, nowPanelData.logFail) as shape NowLog else empty()
  action nowSelect(id: string)
    nowSel = (id == nowSel) ? "" : id
  action nowExpand(id: string)
    nowOpen = (id == nowOpen) ? "" : id
  action nowClose
    nowSel = ""
  action nowToggleMore
    nowMore = not nowMore
  action nowFilter(kind: string, v: string)
    nowSel = ""
    nowOpen = ""
    // the filter replaces Live's visit (one Live mounted, no stack of filtered copies)
    nav = replace(nav, v == "" ? "/" : `/?${kind}=${encodeURIComponent(v)}`)
  action nowClear
    nav = replace(nav, "/")
  action nowKey(k: string)
    if k == "Escape" and (nowSel != "" or nowOpen != "")
      preventDefault()
      nowSel = ""
      nowOpen = ""

fn toneInk(t: string): string = t == "run" ? "zr.run" : (t == "fail" ? "zr.fail" : (t == "wait" ? "zr.ink3" : (t == "pass" ? "sy.green-ink" : "zr.ink3")))
fn healthInk(h: string): string = (h == "down" or h == "degraded") ? "zr.fail" : (h == "up" ? "sy.green-ink" : "zr.ink3")
// the Yard's chips (src/yard/gfx.ts chip): ok green, bad red, active solid, the rest dashed
fn chipEdge(st: string): string = st == "ok" ? "sy.green-edge" : (st == "bad" ? "sy.red-edge" : (st == "active" ? "#9A9A9C" : "sy.chip-edge"))
fn chipFill(st: string): string = st == "ok" ? "sy.green-fill" : (st == "bad" ? "sy.red-fill" : "transparent")
fn chipInk(st: string): string = st == "ok" ? "sy.green-ink" : (st == "bad" ? "sy.red-text" : (st == "active" ? "sy.ink" : (st == "wait" ? "sy.amber-text" : (st == "skip" ? "zr.ink3" : "#8C8C8E"))))
fn toneSt(t: string): string = t == "pass" ? "ok" : (t == "fail" ? "bad" : (t == "run" ? "active" : (t == "wait" ? "wait" : "skip")))
fn healthGlyph(h: string): string = h == "up" ? "✓" : ((h == "down" or h == "degraded") ? "✕" : "?")

// The primary view.
component NowView
  props
    d: NowFeed
    p: NowPanel
    log: NowLog
    sel: string
    open: string
    mode: string
    reduced: bool
    narrow: bool
    more: bool
    select: action
    expand: action
    close: action
    only: action
    clear: action
    key: action
    toggleMore: action
    settings: action
  view
    column flex=1 min-height=0 background-color="zr.bg" color="zr.ink" font-family="Commit Mono" testId="now" key=key
      NowStatus(d=d, mode=mode, reduced=reduced, narrow=narrow, sel=sel, select=select, clear=clear)
      scroll flex=1 min-height=0 testId="now-scroll"
        column padding=(narrow ? "0 12px 40px" : "0 16px 48px") gap=0
          if sel.startsWith("machine:")
            NowDetail(p=p, log=log, narrow=narrow, select=select, close=close)
          if not d.ok
            text "Waiting for the server’s first snapshot…" font-size=12 color="zr.ink2" padding=(narrow ? "24px 0" : "20px 0 20px 64px") testId="now-loading"
          if d.ok and d.needs.length > 0
            NowHeading(word="needs a human", count=`${d.needsN}`, note="", narrow=narrow, testKey="needs")
            for n, ni in d.needs key=n.id
              if more or ni < 3
                NowNeedRow(n=n, narrow=narrow, testKey=`${ni}`)
            if d.needsMore != ""
              button appearance="none" press=toggleMore testId="now-needs-more" text-align="start" padding=(narrow ? "8px 0" : "6px 0 6px 64px") border-top="1px solid zr.rule"
                text (more ? "show fewer" : d.needsMore) font-size=11.5 color="zr.ink2"
          if d.ok
            NowHeading(word="now", count=(d.idle ? "" : `${d.running} building`), note=(d.idle ? "nothing building" : `${d.queued} waiting · ${d.now.length} ${d.now.length == 1 ? "event" : "events"}`), narrow=narrow, testKey="now")
          if d.ok and d.idle
            text d.idleText font-size=12 color="zr.ink2" padding=(narrow ? "14px 0" : "10px 0 10px 64px") border-top="1px solid zr.rule" testId="now-idle"
          for b, bi in d.now key=b.id
            NowBlock(b=b, p=p, log=log, sel=sel, narrow=narrow, reduced=reduced, testKey=`${bi}`, select=select, only=only, close=close)
          if d.just.length > 0
            NowHeading(word="just finished", count="", note="last 15 min", narrow=narrow, testKey="just")
            for b, bi in d.just key=b.id
              NowDone(b=b, p=p, log=log, sel=sel, open=open, dim=false, narrow=narrow, reduced=reduced, testKey=`just-${bi}`, select=select, expand=expand, only=only, close=close)
          if d.earlier.length > 0
            NowHeading(word="earlier", count="", note="last 2 h", narrow=narrow, testKey="earlier")
            for b, bi in d.earlier key=b.id
              NowDone(b=b, p=p, log=log, sel=sel, open=open, dim=true, narrow=narrow, reduced=reduced, testKey=`earlier-${bi}`, select=select, expand=expand, only=only, close=close)

// The status line: LIVE and the clock, what runs and waits, each machine's slots, the filter.
component NowStatus
  props
    d: NowFeed
    mode: string
    reduced: bool
    narrow: bool
    sel: string
    select: action
    clear: action
  view
    // the Yard's top line: LIVE (green, spaced), the headline in 19, the rest in muted captions
    row flex-shrink=0 flex-wrap="wrap" align-items="baseline" column-gap=14 row-gap=6 padding=(narrow ? "10px 12px 8px" : "14px 16px 10px") testId="now-status"
      row gap=6 align-items="baseline" testId="now-live"
        text (mode == "live" ? "LIVE" : (mode == "replay" ? "REPLAY" : (mode == "paused" ? "PAUSED" : "BEHIND"))) font-size=11 letter-spacing="1px" color=(mode == "live" ? "sy.green" : "sy.amber-text") animation=((mode == "live" and not reduced) ? "nowBeat 1s ease-in-out infinite alternate" : "none")
      row gap=8 align-items="baseline" white-space="nowrap" testId="now-counts"
        text `${d.running}` font-size=19 font-weight=700 color=(d.running > 0 ? "zr.run" : "zr.ink") testId="now-running"
        text "building" font-size=19 font-weight=700 color="zr.ink"
        text "·" font-size=19 color="zr.ink3"
        text `${d.queued}` font-size=19 font-weight=700 color="zr.ink" testId="now-queued"
        text "waiting" font-size=19 font-weight=700 color="zr.ink"
      if not narrow
        text `${d.clock} · ${d.needsN} need a human` font-size=11.5 color="zr.ink3" white-space="nowrap" testId="now-clock"
      row flex=1
      if d.filtered
        row gap=8 align-items="baseline" testId="now-filter"
          text "only" font-size=11.5 color="zr.ink3"
          text d.filterText font-size=11.5 font-weight=700
          button appearance="none" press=clear testId="now-filter-clear" padding="1px 7px" border-radius=3 border="1px dashed sy.chip-edge"
            text "show everything" font-size=11 color="zr.ink2"
    // engines · slots: each machine, its slots, busy of total (a press: what runs there)
    row flex-shrink=0 flex-wrap="wrap" align-items="center" column-gap=22 row-gap=4 padding=(narrow ? "0 12px 10px" : "0 16px 12px") border-bottom="1px solid zr.rule" testId="now-machines"
      row gap=8 align-items="baseline" testId="now-intake"
        text "intake" font-size=11.5 font-weight=700 color="zr.ink"
        text d.intake font-size=11.5 color=(d.intake == "empty" ? "zr.ink3" : "sy.amber-text") white-space="nowrap"
      text "engines · slots" font-size=11 color="zr.ink3"
      for m, mi in d.machines key=m.id
        button appearance="none" press=select(`machine:${m.id}`) testId=`now-mach-${mi}` aria-label=`${m.label}: ${m.text} busy. What runs there.` aria-expanded=(sel == `machine:${m.id}`)
          padding="2px 4px" border-radius=3 background-color=(sel == `machine:${m.id}` ? "zr.raise" : "transparent")
          :hover
            background-color="zr.raise"
          row gap=7 align-items="center"
            text m.label font-size=11.5 color=(m.offline ? "zr.ink3" : "zr.ink2") white-space="nowrap"
            if m.cells.length > 0
              // the Yard's slots: an empty ring each; a busy one holds its packet and an amber arc
              // that fills with the job's elapsed time against its usual (dashed when unknown)
              svg width=(m.cells.length * 16) height=16 viewBox=`0 0 ${m.cells.length * 16} 16` aria-hidden=true
                for c, ci in m.cells key=c.id
                  circle cx=(ci * 16 + 8) cy=8 r=4.5 fill="none" stroke="#3A3A3C" stroke-width=1 stroke-dasharray=(m.offline ? "1.5 2" : "none")
                  if c.on
                    circle cx=(ci * 16 + 8) cy=8 r=2.2 fill="#8A7146"
                    if c.known
                      circle cx=(ci * 16 + 8) cy=8 r=6.5 fill="none" stroke="#E5B567" stroke-width=1.3 stroke-dasharray=`${c.pct * 40.84} 40.84` transform=`rotate(-90 ${ci * 16 + 8} 8)`
                    else
                      circle cx=(ci * 16 + 8) cy=8 r=6.5 fill="none" stroke="#E5B567" stroke-opacity=0.7 stroke-width=1.2 stroke-dasharray="2 2.5"
            text m.text font-size=11.5 color=(m.offline ? "zr.ink3" : "zr.ink2") font-variant-numeric="tabular-nums" testId=`now-mach-${mi}-text`

// A section heading: the word, a count, a note; a hairline above the first row.
component NowHeading
  props
    word: string
    count: string
    note: string
    narrow: bool
    testKey: string
  view
    // the Yard's section heads: the word in bold ink, then " · count · note" muted, lowercase
    row gap=0 align-items="baseline" padding=(narrow ? "18px 0 6px" : "20px 0 7px 64px") testId=`now-h-${testKey}`
      text word role="heading" aria-level=2 font-size=12 font-weight=700 color="zr.ink"
      if count != ""
        text "·" font-size=11.5 color="zr.ink3" padding="0 7px"
        text count font-size=11.5 color="sy.amber-text" testId=`now-h-${testKey}-count`
      if note != ""
        text "·" font-size=11.5 color="zr.ink3" padding="0 7px"
        text note font-size=11.5 color="zr.ink3"

// One visible link button: a grey hairline, the label, ↗. Opens in a new tab (web) or the browser.
component NowLinks
  props
    links: NowLink[]
    testKey: string
  view
    // the Yard's bracket boxes: dashed, 18 high, the word and a small ↗
    row gap=4 align-items="center" flex-shrink=0
      for l in links key=l.id
        link href=l.url testId=`now-link-${testKey}-${l.id}` aria-label=`${l.label} (opens in a new tab)` height=18 padding="0 5px" border-radius=3 border="1px dashed sy.chip-edge" display="flex" align-items="center" gap=3 white-space="nowrap" text-decoration="none"
          :hover
            border-color="zr.ink3"
          :focus-visible
            box-shadow="0 0 0 1px #9A9A9C"
          text l.label font-size=11 color="#8C8C8E"
          text "↗" font-size=10 color="zr.ink3"

// A thing that needs a human: red only on its ✕ and its status word.
component NowNeedRow
  props
    n: NowNeed
    narrow: bool
    testKey: string
  view
    // the Yard's main-line row: name (bold) · red 17h · sha message · author · its bead trail
    row min-height=24 flex-wrap="wrap" align-items="center" column-gap=12 row-gap=2 padding=(narrow ? "4px 0" : "2px 0 2px 64px") testId=`now-need-${testKey}`
      text n.what font-size=12 font-weight=700 white-space="nowrap" width=(narrow ? "auto" : 230) overflow="hidden" text-overflow="ellipsis" flex-shrink=0
      text n.word font-size=11.5 color="zr.fail" white-space="nowrap" width=(narrow ? "auto" : 104) flex-shrink=0 testId=`now-need-${testKey}-word`
      if not narrow
        row gap=8 align-items="baseline" flex=1 min-width=0
          if n.sha != ""
            text n.sha font-size=10 color="zr.ink3" flex-shrink=0
          text n.detail font-size=11.5 color="zr.ink2" min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if n.who != ""
            text `· ${n.who}` font-size=11.5 color="zr.ink3" white-space="nowrap" flex-shrink=0
          if n.ago != ""
            text `· ${n.ago}` font-size=11.5 color="zr.ink3" white-space="nowrap" flex-shrink=0
      if n.beads.length > 0
        svg width=(n.beads.length * 13 + 14) height=14 viewBox=`0 0 ${n.beads.length * 13 + 14} 14` aria-hidden=true flex-shrink=0
          line x1=0 y1=7 x2=(n.beads.length * 13 + 8) y2=7 stroke="#2A2A2B" stroke-width=1
          for d, di in n.beads key=d.id
            if d.st == "bad"
              line x1=(di * 13 + 6.5) y1=7 x2=(di * 13 + 19.5) y2=7 stroke="#E06464" stroke-opacity=0.8 stroke-width=1.2
            if d.st == "ok"
              circle cx=(di * 13 + 6.5) cy=7 r=4 fill=(di == n.beads.length - 1 ? "#F2F2F0" : "#A3A3A3")
            if d.st == "bad"
              circle cx=(di * 13 + 6.5) cy=7 r=4 fill="#E06464"
            if d.st == "was"
              circle cx=(di * 13 + 6.5) cy=7 r=3.5 fill="none" stroke="#E06464" stroke-opacity=0.45 stroke-width=1
            if d.st == "run"
              circle cx=(di * 13 + 6.5) cy=7 r=4 fill="#F2F2F0" stroke="#E5B567" stroke-width=1.2
            if d.st == "skip"
              circle cx=(di * 13 + 6.5) cy=7 r=2.8 fill="#4E4E50"
            if d.cul
              circle cx=(di * 13 + 6.5) cy=7 r=6 fill="none" stroke="#E06464" stroke-opacity=0.7 stroke-width=1
          rect x=(n.beads.length * 13 + 7) y=1 width=3.5 height=12 rx=1.5 fill="#19191A" stroke="#545456" stroke-width=1
      NowLinks(links=n.links, testKey=`need-${testKey}`)

// An event in flight: its time, the event line, and every job it started as a tree under it.
component NowBlock
  props
    b: NowEvent
    p: NowPanel
    log: NowLog
    sel: string
    narrow: bool
    reduced: bool
    testKey: string
    select: action
    only: action
    close: action
  view
    row align-items="flex-start" gap=12 padding="8px 0 6px" border-top="1px solid zr.rule" testId=`now-ev-${testKey}` animation=(reduced ? "none" : "nowIn 360ms ease-out both") -exact-layout-transition=(reduced ? "none" : "320ms ease") -exact-exit-animation=(reduced ? "none" : "nowOut 260ms ease-in both")
      if not narrow
        column width=52 flex-shrink=0 gap=1 padding-top=2
          text b.time font-size=11.5 font-variant-numeric="tabular-nums"
          text b.ago font-size=11 color="zr.ink3"
      column flex=1 min-width=0 gap=2
        NowEventLine(b=b, narrow=narrow, testKey=testKey, only=only)
        if b.jobs.length == 0
          row min-height=30 gap=10 align-items="center" testId=`now-nojobs-${testKey}`
            text "└" font-size=11.5 color="zr.ink4" width=14 aria-hidden=true
            text "○" font-size=11 color="zr.ink3" width=14 text-align="center"
            text "pushed · no CI run has started yet" font-size=11.5 color="zr.ink3"
        for j, ji in b.jobs key=j.id
          NowJobLine(j=j, narrow=narrow, reduced=reduced, sel=sel, testKey=`${testKey}-${ji}`, select=select)
          if sel == j.sel
            NowDetail(p=p, log=log, narrow=narrow, select=select, close=close)
        if b.more != ""
          text b.more font-size=11.5 color="zr.ink3" padding-left=28

// The event: kind, repo (a press shows only that repo), branch, sha, message, who; its link.
component NowEventLine
  props
    b: NowEvent
    narrow: bool
    testKey: string
    only: action
  view
    row flex-wrap="wrap" align-items="baseline" column-gap=10 row-gap=2 min-height=22
      text b.kind font-size=11 font-weight=700 color="zr.ink3" white-space="nowrap"
      button appearance="none" press=only("repo", b.repoFull) testId=`now-repo-${testKey}` aria-label=`Show only ${b.repoFull}` padding=0
        text b.repo font-size=12 font-weight=700 white-space="nowrap"
      if not narrow
        text b.branch font-size=12 color="zr.ink3" white-space="nowrap" max-width=260 overflow="hidden" text-overflow="ellipsis"
        text b.sha font-size=11.5 color="zr.ink3"
      text b.title font-size=12 color="zr.ink2" flex=(narrow ? "1 1 100%" : "1 1 0") min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" order=(narrow ? 5 : 0)
      if narrow
        text b.ago font-size=11 color="zr.ink3" white-space="nowrap" flex=1
      if b.who != "" and not narrow
        text b.who font-size=11.5 color="zr.ink3" white-space="nowrap"
      NowLinks(links=b.links, testKey=`ev-${testKey}`)

// One job as a Yard chain: tree · state · kind (press: its steps and log) --> where (press: the
// machine) --> its steps, lit as they pass --> the timer against the usual, or how it ended.
component NowJobLine
  props
    j: NowJob
    narrow: bool
    reduced: bool
    sel: string
    testKey: string
    select: action
  view
    column testId=`now-job-${testKey}` animation=(reduced ? "none" : "nowIn 300ms ease-out both")
      row min-height=24 flex-wrap="wrap" align-items="center" column-gap=4 row-gap=4
        text (j.last ? "└" : "├") font-size=11.5 color="zr.ink4" width=14 flex-shrink=0 aria-hidden=true
        text j.glyph font-size=11 font-weight=700 color=toneInk(j.tone) width=14 text-align="center" flex-shrink=0 aria-label=j.state
        button appearance="none" press=select(j.sel) testId=`now-jobpress-${testKey}` aria-expanded=(sel == j.sel) aria-label=`${j.full}: ${j.state}. Show its steps and log.` title=j.full
          padding="1px 4px" border-radius=3 background-color=(sel == j.sel ? "zr.raise" : "transparent") width=(narrow ? "auto" : 220) flex-shrink=0 text-align="start"
          :hover
            background-color="zr.raise"
          row gap=6 align-items="baseline" min-width=0
            text j.kind font-size=11.5 font-weight=700 white-space="nowrap"
            if j.app != ""
              text `→ ${j.app}` font-size=11.5 color="zr.ink2" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
            else
              text j.name font-size=11 color="zr.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        for c, ci in j.chain key=c.id
          if ci > 0
            NowArrow(long=c.arrow)
          if ci == 0 and j.machineSel != ""
            button appearance="none" press=select(j.machineSel) testId=`now-where-${testKey}` aria-label=`Runs on ${j.where}. What else runs there.` padding=0 border-radius=3
              :hover
                background-color="zr.raise"
              NowChipBox(c=c, reduced=reduced)
          else
            NowChipBox(c=c, reduced=reduced)
        if j.state == "running" or j.state == "queued" or j.state == "waiting"
          if j.state == "running"
            NowArrow(long=true)
            row gap=4 align-items="baseline" flex-shrink=0 padding-left=2
              text j.timer font-size=11.5 font-weight=700 color="zr.run" font-variant-numeric="tabular-nums" testId=`now-timer-${testKey}`
              if j.usual != ""
                text j.usual font-size=11 color=(j.over ? "sy.amber-text" : "zr.ink3") font-variant-numeric="tabular-nums" white-space="nowrap"
        else
          NowArrow(long=true)
          NowTag(text=(j.dur != "" ? `${j.result} ${j.dur}` : j.result), st=toneSt(j.tone), testKey=`now-result-${testKey}`)
          if j.app != "" and j.health != ""
            NowArrow(long=true)
            NowTag(text=`${j.app} · ${j.health}`, st=(j.health == "up" ? "ok" : ((j.health == "down" or j.health == "degraded") ? "bad" : "idle")), testKey=`now-health-${testKey}`)
        // the Yard's caption after the timer, cut before it wraps
        if j.state == "running" and j.note != "" and not narrow
          text `· ${j.note}` font-size=11 color="zr.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex="1 1 0" min-width=0 padding-left=6
        else
          row flex=1 min-width=8
        NowLinks(links=j.links, testKey=`job-${testKey}`)
      if j.err != ""
        text j.err font-size=11 color="zr.ink2" padding="0 0 4px 32px" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// A finished event on one line; a press shows its jobs under it.
component NowDone
  props
    b: NowEvent
    p: NowPanel
    log: NowLog
    sel: string
    open: string
    dim: bool
    narrow: bool
    reduced: bool
    testKey: string
    select: action
    expand: action
    only: action
    close: action
  view
    column border-top="1px solid zr.rule" opacity=(dim and open != b.sel ? 0.66 : 1) testId=`now-done-${testKey}` animation=(reduced ? "none" : "nowIn 420ms ease-out both") -exact-layout-transition=(reduced ? "none" : "320ms ease")
      row min-height=26 flex-wrap="wrap" align-items="center" column-gap=10 row-gap=2
        button appearance="none" press=expand(b.sel) testId=`now-donepress-${testKey}` aria-expanded=(open == b.sel) aria-label=`${b.kind} ${b.repo} ${b.branch}: ${b.state}. Show its jobs.`
          flex=1 min-width=0 padding="4px 6px" margin-left=-6 border-radius=5 text-align="start" background-color=(open == b.sel ? "zr.raise" : "transparent")
          :hover
            background-color="zr.raise"
          row gap=10 align-items="baseline" min-width=0
            if not narrow
              text b.time font-size=11.5 color="zr.ink3" width=52 flex-shrink=0 font-variant-numeric="tabular-nums"
            text b.glyph font-size=11 font-weight=700 color=toneInk(b.tone) width=14 text-align="center" flex-shrink=0 aria-label=b.state
            text b.kind font-size=11 font-weight=700 color="zr.ink3" white-space="nowrap"
            text b.repo font-size=12 font-weight=700 white-space="nowrap"
            if not narrow
              text b.branch font-size=11.5 color="zr.ink3" white-space="nowrap" max-width=200 overflow="hidden" text-overflow="ellipsis"
            text (b.result != "" ? b.result : b.title) font-size=11.5 color=(b.result != "" ? toneInk(b.tone) : "zr.ink2") flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
            if not narrow
              row gap=12 align-items="baseline" flex-shrink=0
                for c in b.chain key=c.id
                  row gap=4 align-items="center"
                    NowTag(text=(c.app != "" ? `${c.text} → ${c.app}` : c.text), st=toneSt(c.tone), testKey=`now-chain-${c.id}`)
                    if c.health != ""
                      NowArrow(long=false)
                      NowTag(text=c.health, st=(c.health == "up" ? "ok" : ((c.health == "down" or c.health == "degraded") ? "bad" : "idle")), testKey=`now-chainh-${c.id}`)
                if b.chainMore != ""
                  text b.chainMore font-size=11 color="zr.ink3"
            text b.ago font-size=11 color="zr.ink3" white-space="nowrap" width=44 text-align="end" flex-shrink=0
        NowLinks(links=b.links, testKey=`done-${testKey}`)
      if open == b.sel
        column padding=(narrow ? "0 0 10px 0" : "0 0 8px 64px")
          text b.title font-size=11.5 color="zr.ink2" padding="0 0 4px 0"
          for j, ji in b.jobs key=j.id
            NowJobLine(j=j, narrow=narrow, reduced=reduced, sel=sel, testKey=`${testKey}-${ji}`, select=select)
            if sel == j.sel
              NowDetail(p=p, log=log, narrow=narrow, select=select, close=close)

// The open detail, inline: a job's steps and its log tail (the error line marked), or what runs on
// a machine. Indented under its line; grey hairlines only.
component NowDetail
  props
    p: NowPanel
    log: NowLog
    narrow: bool
    select: action
    close: action
  view
    column gap=8 padding=(narrow ? "8px 0 12px 0" : "8px 0 14px 48px") testId="now-detail"
      row flex-wrap="wrap" gap=10 align-items="baseline"
        text p.title font-size=12 font-weight=700 testId="now-detail-title"
        text p.sub font-size=11.5 color="zr.ink3"
        row flex=1
        NowLinks(links=p.links, testKey="detail")
        button appearance="none" press=close testId="now-detail-close" aria-label="Close" height=18 padding="0 5px" border-radius=3 border="1px dashed sy.chip-edge"
          text "close ×" font-size=11 color="#8C8C8E"
      if p.empty != ""
        text p.empty font-size=11.5 color="zr.ink3"
      if p.steps.length > 0
        column border-top="1px solid zr.rule" padding-top=4 testId="now-steps"
          for s in p.steps key=s.id
            column
              row min-height=24 gap=8 align-items="baseline" padding-left=(s.depth * 22)
                text s.glyph font-size=11 font-weight=700 color=toneInk(s.tone) width=14 text-align="center"
                text s.name font-size=11.5 font-weight=(s.depth == 0 ? 600 : 400) color=(s.depth == 0 ? "zr.ink" : "zr.ink2")
                if s.cached
                  text "cached" font-size=11 color="zr.ink3"
                text s.dur font-size=11 color="zr.ink3"
                if s.url != ""
                  link href=s.url font-size=11 color="zr.ink3" aria-label=`Open step ${s.name} in Roadrunner`
                    text "↗"
              if s.err != ""
                text s.err font-size=11 color="zr.ink2" padding-left=(s.depth * 22 + 22) white-space="pre-wrap"
      if p.runs.length > 0
        column border-top="1px solid zr.rule" padding-top=4 testId="now-runs"
          for r in p.runs key=r.id
            row min-height=28 gap=10 align-items="center"
              text r.glyph font-size=11 font-weight=700 color=toneInk(r.tone) width=14 text-align="center"
              text r.repo font-size=12 font-weight=700
              text r.kind font-size=11.5 color="zr.ink2"
              text r.step font-size=11.5 color="zr.ink2" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              text r.timer font-size=11.5 color="zr.run"
              link href=r.url padding="2px 8px" border-radius=5 border="1px solid zr.rule2" text-decoration="none"
                text "roadrunner ↗" font-size=11 color="#8C8C8E"
      if p.logCap and p.logStep != ""
        column gap=4 testId="now-log"
          row gap=10 align-items="baseline"
            text `log · ${p.logStep}` font-size=11.5 font-weight=700 color="zr.ink"
            text log.note font-size=11 color="zr.ink3" testId="now-log-note"
          if log.rows.length > 0
            column padding="8px 10px" border="1px solid zr.rule" border-radius=6 max-height=420 overflow-y="auto" font-size=11
              for r in log.rows key=r.id
                row gap=10 align-items="baseline"
                  text r.n color="zr.ink4" width=40 text-align="end" flex-shrink=0 font-variant-numeric="tabular-nums"
                  text (r.hot ? "✕" : " ") color="zr.fail" width=10 flex-shrink=0
                  text r.text color=(r.hot ? "zr.ink" : "zr.ink2") font-weight=(r.hot ? 700 : 400) white-space="pre-wrap" min-width=0

// One chip of a chain, drawn as the Yard draws its step boxes.
component NowChipBox
  props
    c: NowChip
    reduced: bool
  view
    row align-items="center" height=18 padding="0 6px" border-radius=3 border-width=1 border-style=(c.st == "active" ? "solid" : "dashed") border-color=chipEdge(c.st) background-color=chipFill(c.st) flex-shrink=0
      animation=((c.hot and not reduced) ? "nowHot 0.9s ease-in-out infinite alternate" : "none")
      text c.text font-size=11 color=chipInk(c.st) white-space="nowrap"

// A result chip (words and a state, no shape behind it).
component NowTag
  props
    text: string
    st: string
    testKey: string
  view
    row align-items="center" height=18 padding="0 6px" border-radius=3 border-width=1 border-style="dashed" border-color=chipEdge(st) background-color=chipFill(st) flex-shrink=0 testId=testKey
      text text font-size=11 color=chipInk(st) white-space="nowrap"

// The Yard's dashed connector with its arrowhead.
component NowArrow
  props
    long: bool
  view
    svg width=(long ? 20 : 12) height=8 viewBox=(long ? "0 0 20 8" : "0 0 12 8") aria-hidden=true flex-shrink=0
      line x1=1 y1=4 x2=(long ? 15.5 : 7.5) y2=4 stroke="#6A6A6A" stroke-width=1 stroke-dasharray="2.5 2.5"
      polyline points=(long ? "15.5,1.5 19,4 15.5,6.5" : "7.5,1.5 11,4 7.5,6.5") fill="none" stroke="#6A6A6A" stroke-width=1
