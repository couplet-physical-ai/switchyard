// Commit journey: one commit end to end on one time axis (DESIGN.md, "Views").

use Journey from "./shapes.contract"

members App
  resource jData = journey(server, tok.token, here == "commit" ? `${top(nav).params.owner}/${top(nav).params.name}` : "", here == "commit" ? top(nav).params.sha : "", here == "commit" ? clockMs : 0) as shape Journey else empty(ok=false, error="", repo="", sha="", short="", title="", author="", branch="", stage="", pushed="", total="", spans=[], pipelines=[], deploys=[], deployVia="", app="", health="", healthText="", url="", events=[], ciState="", deployState="", ticks=[])

fn barColor(s: string): string = s == "success" ? "sy.machine" : (s == "failure" or s == "error" ? "sy.red" : (s == "running" ? "sy.amber" : "sy.ink4"))
fn stEdge(s: string): string = s == "failure" ? "sy.red-edge" : (s == "running" ? "sy.amber" : (s == "success" ? "sy.green-edge" : "sy.chip-edge"))
fn stInk(s: string): string = s == "failure" ? "sy.red-text" : (s == "running" ? "sy.amber-text" : (s == "success" ? "sy.green-ink" : "sy.ink3"))
fn stFill(s: string): string = s == "failure" ? "sy.red-fill" : (s == "success" ? "sy.green-fill" : "transparent")

component JourneyView
  props
    j: Journey
    open: action
  view
    scroll flex=1 min-height=0 testId="journey"
      column padding="18px 24px 28px" gap=18
        if not j.ok
          text (j.error != "" ? j.error : "Loading the commit…") color="sy.ink3" font-size=13 testId="journey-empty"
        if j.ok
          column gap=6
            text `${j.repo} · ${j.branch} · ${j.short}` color="sy.ink3" font-size=12
            text j.title role="heading" aria-level=2 font-weight=700 font-size=20 testId="journey-title"
            row gap=12
              text `${j.author} · pushed ${j.pushed} · ${j.stage}` font-size=12 color="sy.ink2" testId="journey-stage"
              link href=j.url
                text "github ↗" font-size=12 color="sy.ink3"
          row gap=0 align-items="center" testId="journey-path"
            for i in [0, 1, 2, 3, 4] key=i
              row align-items="center"
                if i > 0
                  text "- - →" font-size=11 color="sy.ink4" padding="0 8px"
                column padding="4px 10px" border-radius=4 gap=1
                  border-width=1 border-style=((i == 1 and j.ciState != "") or (i == 3 and j.deployState != "") ? "solid" : "dashed")
                  border-color=(i == 1 ? stEdge(j.ciState) : (i == 3 ? stEdge(j.deployState) : (i == 4 and j.health == "up" ? "sy.green-edge" : (i == 4 and j.health == "down" ? "sy.red-edge" : "sy.chip-edge"))))
                  background-color=(i == 1 ? stFill(j.ciState) : (i == 3 ? stFill(j.deployState) : "transparent"))
                  text (i == 0 ? "push" : (i == 1 ? "pipelines" : (i == 2 ? "steps" : (i == 3 ? "deploy" : "health")))) font-size=11
                    color=(i == 1 ? stInk(j.ciState) : (i == 3 ? stInk(j.deployState) : "sy.ink2"))
                  text (i == 0 ? j.pushed : (i == 1 ? `${j.pipelines.length} · ${j.ciState != "" ? j.ciState : "none"}` : (i == 2 ? `${j.spans.length} steps` : (i == 3 ? j.deployVia : (j.health != "" ? j.health : "–"))))) font-size=10 color="sy.ink3"
          row gap=32 align-items="flex-start"
            column gap=8 flex=1 min-width=0
              row justify-content="space-between"
                text "PIPELINES AND STEPS" font-size=11 letter-spacing="0.08em" color="sy.ink3"
                text j.total font-size=11 color="sy.ink3"
              for p in j.pipelines key=p.id
                row gap=12 padding="2px 0" align-items="baseline"
                  text `#${p.number}` width=104 font-size=12 font-weight=700 color="sy.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  text `${p.lane}${p.engine != "" ? ` · ${p.engine}` : ""}` width=212 font-size=12 color="sy.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  text p.state width=72 font-size=12 color=(p.state == "failure" or p.state == "error" ? "sy.red-text" : (p.state == "running" ? "sy.amber-text" : (p.state == "success" ? "sy.green-ink" : "sy.ink3")))
                  text `waited ${p.wait} · ran ${p.dur}` font-size=12 color="sy.ink3" white-space="nowrap"
              column gap=2 testId="waterfall"
                row gap=10 height=14 align-items="flex-end"
                  text "" width=200
                  row flex=1 justify-content="space-between" border-bottom="1px solid sy.rule"
                    for t, ti in j.ticks key=ti
                      text t font-size=10 color="sy.ink4" font-variant-numeric="tabular-nums"
                  text "" width=90
                for s in j.spans key=s.id
                  row gap=10 align-items="center" height=17
                    text s.name width=200 font-size=11 color=(s.state == "failure" or s.state == "error" ? "sy.red-text" : (s.depth == 0 ? "sy.ink2" : "sy.ink3")) padding-left=`${s.depth * 12}px` white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                    row flex=1 height=8 position="relative"
                      column position="absolute" top=0 bottom=0 left=`${s.start * 100}%` width=`${s.width * 100}%` min-width=2 border-radius=2
                        background-color=barColor(s.state) opacity=(s.cached ? 0.45 : 1) border=(s.cached ? "1px dashed sy.ink3" : "none")
                    text (s.cached ? `${s.dur} cached` : s.dur) width=90 font-size=11 color="sy.ink3" text-align="right" white-space="nowrap"
                for d in j.deploys key=d.app
                  row gap=10 align-items="center" height=17
                    text `deploy ${d.app}` width=200 font-size=11 color="sy.amber-text" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                    row flex=1 height=8 position="relative"
                      column position="absolute" top=0 bottom=0 left=`${d.start * 100}%` width=`${d.width * 100}%` min-width=2 border-radius=2 background-color=(d.state == "failure" ? "sy.red" : "sy.amber")
                    text `${d.dur} · ${d.via}` width=90 font-size=11 color="sy.ink3" text-align="right" white-space="nowrap"
            column gap=14 width=440 flex-shrink=0
              if j.events.length > 0
                column gap=5 testId="journey-story"
                  text "WHAT HAPPENED" font-size=11 letter-spacing="0.08em" color="sy.ink3"
                  for e in j.events key=e.id
                    row gap=10 align-items="baseline" border-left-width=1 border-left-style="solid" border-left-color=(e.k == "finish" or e.k == "health" ? "sy.edge" : "sy.rule") padding-left=10
                      text e.at width=40 font-size=11 color="sy.ink3" font-variant-numeric="tabular-nums"
                      text e.k width=60 font-size=11 color=(e.k == "finish" or e.k == "health" ? "sy.ink2" : (e.k == "deploy" or e.k == "deployed" ? "sy.amber-text" : "sy.ink3"))
                      text e.label font-size=11 color="sy.ink2" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                      text e.ago font-size=10 color="sy.ink3" white-space="nowrap"
              if j.app != ""
                column gap=4
                  text "AFTER" font-size=11 letter-spacing="0.08em" color="sy.ink3"
                  row gap=8 align-items="center"
                    column width=8 height=8 border-radius=2 background-color=(j.health == "up" ? "sy.green" : (j.health == "down" ? "sy.red" : "sy.amber"))
                    text j.app font-size=12 color="sy.ink2"
                  text j.healthText font-size=11 color="sy.ink3" testId="journey-health"
