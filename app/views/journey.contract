// Commit journey: one commit end to end on one time axis (DESIGN.md, "Views").

use Journey from "./shapes.contract"

members App
  resource jData = journey(server, tok.token, here == "commit" ? `${top(nav).params.owner}/${top(nav).params.name}` : "", here == "commit" ? top(nav).params.sha : "", here == "commit" ? clockMs : 0) as shape Journey else empty(ok=false, error="", repo="", sha="", short="", title="", author="", branch="", stage="", pushed="", total="", spans=[], pipelines=[], deploys=[], deployVia="", app="", health="", healthText="", url="")

fn barColor(s: string): string = s == "success" ? "sy.machine" : (s == "failure" or s == "error" ? "sy.red" : (s == "running" ? "sy.amber" : "sy.ink4"))

component JourneyView
  props
    j: Journey
    open: action
  view
    scroll flex=1 min-height=0 testId="journey"
      column padding="18px 24px 28px" gap=18
        if not j.ok
          text (j.error != "" ? j.error : "Loading the commit…") color="sy.ink3" font-size=13 testId="journey-empty"
        if j.ok
          column gap=6
            text `${j.repo} · ${j.branch} · ${j.short}` color="sy.ink3" font-size=12
            text j.title role="heading" aria-level=2 font-weight=700 font-size=20 testId="journey-title"
            row gap=12
              text `${j.author} · pushed ${j.pushed} · ${j.stage}` font-size=12 color="sy.ink2" testId="journey-stage"
              link href=j.url
                text "github ↗" font-size=12 color="sy.ink3"
          row gap=0 align-items="center" testId="journey-path"
            for i in [0, 1, 2, 3, 4] key=i
              row align-items="center"
                if i > 0
                  text "- - →" font-size=11 color="sy.ink4" padding="0 8px"
                column padding="4px 9px" border-radius=4 border="1px dashed sy.chip-edge" gap=1
                  text (i == 0 ? "push" : (i == 1 ? "pipelines" : (i == 2 ? "steps" : (i == 3 ? "deploy" : "health")))) font-size=11 color="sy.ink2"
                  text (i == 0 ? j.pushed : (i == 1 ? `${j.pipelines.length}` : (i == 2 ? `${j.spans.length} spans` : (i == 3 ? j.deployVia : (j.health != "" ? j.health : "–"))))) font-size=10 color="sy.ink4"
          column gap=8
            row justify-content="space-between"
              text "PIPELINES AND STEPS" font-size=12 letter-spacing="0.08em" color="sy.ink3"
              text `0 → ${j.total}` font-size=11 color="sy.ink4"
            for p in j.pipelines key=p.id
              row gap=12 padding="2px 0"
                text `#${p.number}` width=70 font-size=12 font-weight=700 color="sy.ink"
                text `${p.lane}${p.engine != "" ? ` · ${p.engine}` : ""}` width=170 font-size=12 color="sy.ink3"
                text p.state width=80 font-size=12 color=(p.state == "failure" ? "sy.red-text" : (p.state == "running" ? "sy.amber-text" : "sy.ink3"))
                text `waited ${p.wait} · ran ${p.dur}` font-size=12 color="sy.ink4"
            column gap=3 testId="waterfall"
              for s in j.spans key=s.id
                row gap=10 align-items="center" height=18
                  text s.name width=200 font-size=11 color=(s.depth == 0 ? "sy.ink2" : "sy.ink3") padding-left=`${s.depth * 12}px` white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  row flex=1 height=10 position="relative"
                    column position="absolute" top=0 bottom=0 left=`${s.start * 100}%` width=`${s.width * 100}%` border-radius=2
                      background-color=barColor(s.state) opacity=(s.cached ? 0.45 : 1) border=(s.cached ? "1px dashed sy.ink3" : "none")
                  text (s.cached ? `${s.dur} cached` : s.dur) width=90 font-size=11 color="sy.ink4" text-align="right"
              for d in j.deploys key=d.app
                row gap=10 align-items="center" height=18
                  text `deploy ${d.app}` width=200 font-size=11 color="sy.amber-text"
                  row flex=1 height=10 position="relative"
                    column position="absolute" top=0 bottom=0 left=`${d.start * 100}%` width=`${d.width * 100}%` border-radius=2 background-color=(d.state == "failure" ? "sy.red" : "sy.amber")
                  text `${d.dur} · ${d.via}` width=90 font-size=11 color="sy.ink4" text-align="right"
          if j.app != ""
            column gap=4
              text "AFTER" font-size=12 letter-spacing="0.08em" color="sy.ink3"
              row gap=8 align-items="center"
                column width=8 height=8 border-radius=2 background-color=(j.health == "up" ? "sy.green" : (j.health == "down" ? "sy.red" : "sy.amber"))
                text `${j.app} · ${j.healthText}` font-size=12 color="sy.ink2" testId="journey-health"
