// Factory 3 (FACTORY3.md), "the berth board", at /factory?v=3: the delivery line as six stations
// in flow order (waiting → building → checks → main lines → deploy → apps) and, under them, a
// ledger of the last events traced through the same stations. Fixed to the window: no scroll,
// no drag, no zoom. Nothing moves unless a run changes place.
// The board is two canvases (src/factory3/board.ts): the marks and words, repainted only when
// they change, and the squares in transit. A press picks; the inspector docks over the ledger
// (the stations above it never move), and Escape or "close" puts the ledger back.

use Hit, Ack from "./shapes.contract"
use FlLog from "./flow.contract"

shape F3Link
  id: string
  label: string
  url: string

shape F3Item
  id: string
  state: string
  name: string
  note: string

shape F3Fact
  id: string
  k: string
  v: string

shape F3Detail
  ok: bool
  kind: string
  id: string
  name: string
  tag: string
  title: string
  state: string
  word: string
  facts: F3Fact[]
  listTitle: string
  items: F3Item[]
  links: F3Link[]
  logId: string
  logStep: string
  logWorkflow: string
  logLive: bool
  logFail: bool

members App
  // the FAILED bin's window, remembered on this device
  state f3Win = "30m" persist
  // what the inspector shows: a run, a main line (repo) or an app ("" for none)
  state f3Sel = ""
  state f3Kind = ""
  derive f3On = here == "factory" and facV3
  derive f3Sec = floor(clockMs / 1000)
  resource f3D = f3Detail(f3Kind, f3Sel, (f3On and f3Sel != "") ? f3Sec : 0) as shape F3Detail else empty()
  derive f3Dock = f3Sel != "" and f3D.ok
  // what the board did, for the tests and the HUD (asks, paints, transits)
  resource f3S = f3Stats(ov.tick) as shape Ack else empty(ok=false, status="")
  resource f3L = f3Log(f3D.logId, f3D.logStep, f3D.logWorkflow, f3D.logLive ? floor(clockMs / 10000) : 0, f3D.logFail) as shape FlLog else empty()
  mutation f3Hit as shape Hit then afterF3Hit
  derive f3Now = match f3Hit { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  // what the pointer is over (its corners are drawn in grey, the cursor is a hand)
  mutation f3Hov as shape Hit
  derive f3Over = match f3Hov { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  action f3Move(e: PointerEvent)
    if e.pointerType == "mouse"
      send f3Hov = f3Pick(e.offsetX, e.offsetY)
  action f3Leave
    if f3Over.label != ""
      send f3Hov = f3Pick(-1, -1)
  action f3Up(e: PointerEvent)
    send f3Hit = f3Pick(e.offsetX, e.offsetY)
  action afterF3Hit
    if f3Now.kind == "window"
      f3Win = f3Now.id
    else if f3Now.kind == "run" or f3Now.kind == "repo" or f3Now.kind == "app"
      if f3Sel == f3Now.id
        f3Sel = ""
      else
        f3Kind = f3Now.kind
        f3Sel = f3Now.id
    else if f3Now.route != ""
      openURL(f3Now.route)
    else
      f3Sel = ""
  action f3Close
    f3Sel = ""
  action f3Key(k: string)
    if k == "Escape" and f3Sel != ""
      preventDefault()
      f3Sel = ""

fn f3Tone(s: string): string = s == "fail" ? "sy.red-text" : (s == "run" ? "sy.amber-text" : "sy.ink2")
fn f3Square(s: string): string = s == "fail" ? "sy.red" : (s == "run" ? "sy.amber" : (s == "pass" ? "sy.ink4" : "transparent"))

// The inspector: docked over the ledger, as wide as the board. Left: what it is, where it
// stands, its links. Middle: the steps (a run) or the last commits (a main line). Right: the
// log, at full width (the decisive line and the lines around it, or a running step's tail).
// It never scrolls and never moves the stations.
component F3Inspector
  props
    d: F3Detail
    log: FlLog
    close: action
  view
    column position="absolute" left=0 right=0 bottom=0 height="44%" box-sizing="border-box" padding="12px 16px 10px" gap=8 background-color="sy.canvas" border-top="1px solid sy.rule" overflow="hidden" font-family="Commit Mono" testId="f3-inspector"
      row gap=10 align-items="baseline" flex-shrink=0
        text d.name font-size=13 font-weight=700 color="sy.ink" white-space="nowrap" testId="f3-name"
        text d.tag font-size=11.5 color="sy.ink3" white-space="nowrap"
        text d.title font-size=11.5 color="sy.ink2" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex=1 min-width=0
        button appearance="none" press=close testId="f3-close" aria-label="Close the inspector" height=18 padding="0 6px" border-radius=3 border="1px solid sy.edge" flex-shrink=0
          text "close · esc" font-size=11 color="sy.ink3"
      row gap=28 flex=1 min-height=0 align-items="stretch"
        column width=320 flex-shrink=0 gap=5 min-height=0 overflow="hidden"
          text d.word font-size=12 color=f3Tone(d.state) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="f3-word"
          for f in d.facts key=f.id
            row gap=8 align-items="baseline" min-width=0
              text f.k font-size=11 color="sy.ink3" width=78 flex-shrink=0 white-space="nowrap"
              text f.v font-size=11 color="sy.ink2" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
          row flex-wrap="wrap" gap=5 padding-top=6
            for l in d.links key=l.id
              link href=l.url testId=`f3-link-${l.id}` aria-label=`${l.label} (opens in a new tab)` height=20 padding="0 7px" border-radius=3 border="1px solid sy.edge" display="flex" align-items="center" gap=4 white-space="nowrap" text-decoration="none"
                :hover
                  border-color="sy.ink3"
                text l.label font-size=11 color="sy.ink2"
                text "↗" font-size=10 color="sy.ink3"
        if d.listTitle != ""
          column width=360 flex-shrink=0 gap=3 min-height=0 overflow="hidden" testId="f3-items"
            text d.listTitle font-size=11.5 font-weight=700 color="sy.ink" padding-bottom=3
            for it in d.items key=it.id
              row gap=8 align-items="center" min-width=0 height=16 flex-shrink=0
                column width=9 height=9 flex-shrink=0 background-color=f3Square(it.state) border=(it.state == "none" or it.state == "wait" ? "1px solid sy.chip-edge" : "none")
                text it.name font-size=11 color=(it.state == "fail" ? "sy.ink" : "sy.ink2") font-weight=(it.state == "fail" ? 700 : 400) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 flex=1
                text it.note font-size=11 color=(it.state == "run" ? "sy.amber-text" : "sy.ink3") white-space="nowrap" flex-shrink=0 font-variant-numeric="tabular-nums"
        if d.logStep != ""
          column flex=1 min-width=0 min-height=0 gap=3 overflow="hidden"
            row gap=8 align-items="baseline" padding-bottom=3 flex-shrink=0
              text `log · ${d.logStep}` font-size=11.5 font-weight=700 color="sy.ink" white-space="nowrap" flex-shrink=0
              text log.note font-size=11 color="sy.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="f3-log-note"
            column gap=1 font-size=10.5 overflow="hidden" min-height=0 flex=1 testId="f3-log"
              for r in log.rows key=r.id
                row gap=6 align-items="baseline" min-width=0 flex-shrink=0
                  text r.n color="sy.ink4" width=34 text-align="end" flex-shrink=0 font-variant-numeric="tabular-nums"
                  text (r.hot ? "✕" : " ") color="sy.red" width=10 flex-shrink=0
                  text r.text color=(r.hot ? "sy.ink" : "sy.ink2") font-weight=(r.hot ? 700 : 400) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
