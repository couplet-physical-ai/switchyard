// PRs: every pull request as a dashed step-chip pipeline (DESIGN.md, "Views").

use Prs, PrRow, PrDetail from "./shapes.contract"

members App
  state prOrg = ""
  state prFilter = "open"
  state prQ = ""
  resource prData = prs(here == "prs" ? clockMs : 0, prOrg, prFilter, prQ) as shape Prs else empty(open=0, ready=0, blocked=0, bots=0, total=0, rows=[])
  resource prDet = prDetail(server, tok.token, here == "pr" ? `${top(nav).params.owner}/${top(nav).params.name}` : "", here == "pr" ? top(nav).params.number : "", here == "pr" ? clockMs : 0) as shape PrDetail else empty(ok=false, row=none, commits=[], pipelines=[], timeline=[])
  action prPickFilter(f: string)
    prFilter = f
  action prTyped(v: string)
    prQ = v

fn phaseLabel(i: number): string = i == 0 ? "draft" : (i == 1 ? "checks" : (i == 2 ? "review" : (i == 3 ? "mergeable" : (i == 4 ? "merged" : "deployed"))))

component Track
  props
    row: PrRow
  view
    row align-items="center" gap=0 aria-label=`phase: ${row.phaseText}`
      for i in [0, 1, 2, 3, 4, 5] key=i
        row align-items="center" gap=0
          if i > 0
            text "→" font-size=10 color=(i <= row.phaseIdx ? "sy.ink3" : "sy.ink4") padding="0 5px"
          column padding="2px 7px" border-radius=4 position="relative"
            border=(i == row.badIdx ? "1px solid sy.red-edge" : (i == row.phaseIdx ? "1px solid sy.machine" : (i < row.phaseIdx ? "1px dashed sy.green-edge" : "1px dashed sy.chip-edge")))
            background-color=(i == row.badIdx ? "sy.red-fill" : (i < row.phaseIdx ? "sy.green-fill" : "transparent"))
            text (i == row.badIdx ? (row.phase == "conflict" ? "conflict" : (row.phase == "changes_requested" ? "changes" : "failing")) : phaseLabel(i)) font-size=11
              color=(i == row.badIdx ? "sy.red-text" : (i == row.phaseIdx ? "sy.ink" : (i < row.phaseIdx ? "sy.green-ink" : "sy.ink4")))
            if i == row.phaseIdx and row.badIdx < 0 and row.phase != "merged" and row.phase != "deployed"
              column position="absolute" top=-7 left="50%" margin-left=-6 width=12 height=7 border-radius=2 background-color="sy.amber"

component Checks
  props
    row: PrRow
  view
    row gap=3 align-items="center" aria-label=`${row.checksOk} of ${row.checksTotal} checks passed`
      for c, i in row.checks key=i
        column width=6 height=6 border-radius=3
          background-color=(c == "success" ? "sy.ink2" : (c == "failure" or c == "error" ? "sy.red" : (c == "running" or c == "pending" ? "sy.amber" : "sy.ink4")))
      text `${row.checksOk}/${row.checksTotal}` font-size=11 color=(row.checksFailed > 0 ? "sy.red-text" : "sy.ink3") margin-left=4

component PrsView
  props
    data: Prs
    filter: string
    q: string
    open: action
    pickFilter: action
    typed: action
  view
    column flex=1 min-height=0 testId="prs"
      header appearance="none" display="flex" align-items="flex-end" gap=16 padding="18px 24px 12px" flex-wrap="wrap"
        column gap=4 flex="1 1 280px"
          text "Pull requests" role="heading" aria-level=2 font-weight=700 font-size=20
          text `${data.open} open · ${data.ready} ready to merge · ${data.blocked} blocked · ${data.bots} from bots` color="sy.ink3" font-size=12 testId="prs-count"
        row role="radiogroup" aria-label="Which" gap=2 padding=3 border-radius=8 background-color="sy.control"
          for f in ["open", "ready", "blocked", "bots", "shipped"] key=f
            button role="radio" aria-checked=(filter == f) press=pickFilter(f) testId=`prs-${f}` padding="4px 10px" border-radius=6
              background-color=(filter == f ? "sy.control-on" : "transparent")
              text f font-size=12 color=(filter == f ? "sy.ink" : "sy.ink3")
        input type="search" value=q input=typed aria-label="Filter pull requests" placeholder="filter prs" testId="prs-filter" width=180
          padding="6px 10px" font-size=12 border-radius=8 background-color="sy.raised" border="1px solid sy.edge" color="sy.ink"
      list id="prs-list" flex=1 min-height=0 padding="0 12px 16px" testId="prs-list"
        for r in data.rows key=r.id
          button press=open(`/pr/${r.repo}/${r.number}`) testId=`pr-${r.id}` appearance="none" width="100%" align-items="stretch" text-align="left" padding="10px 12px" border-radius=8
            row align-items="center" gap=18 flex-wrap="wrap"
              column width=380 min-width=0 gap=4
                row gap=8 align-items="baseline"
                  text `${r.name} #${r.number}` font-weight=700 font-size=13 color="sy.ink" white-space="nowrap"
                  text (r.bot ? `${r.author} · bot` : r.author) font-size=11 color=(r.bot ? "sy.amber-text" : "sy.ink3")
                text r.title font-size=12 color="sy.ink2" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              Track(row=r)
              column flex=1 min-width=160 gap=4 align-items="flex-end"
                Checks(row=r)
                row gap=8
                  if r.ai != ""
                    text `ai ${r.ai}` font-size=11 color="sy.ink4"
                  if r.stale != ""
                    text r.stale font-size=11 color=(r.staleOld ? "sy.amber-text" : "sy.ink4")
                  text r.updated font-size=11 color="sy.ink4"
                if r.blockedBy != ""
                  text `blocked by ${r.blockedBy}` font-size=11 color="sy.red-text"

component PrView
  props
    d: PrDetail
    open: action
  view
    scroll flex=1 min-height=0 testId="pr-detail"
      column padding="18px 24px" gap=18
        match d.row
          case some(r)
            column gap=8
              text `${r.repo} #${r.number}` color="sy.ink3" font-size=12
              text r.title role="heading" aria-level=2 font-weight=700 font-size=20 testId="pr-title"
              row gap=12 align-items="center"
                text (r.bot ? `${r.author} · bot` : r.author) font-size=12 color="sy.ink2"
                text r.phaseText font-size=12 color=(r.bad ? "sy.red-text" : "sy.amber-text") testId="pr-phase"
                link href=r.url
                  text "github ↗" font-size=12 color="sy.ink3"
              Track(row=r)
              Checks(row=r)
          case none
            text (d.ok ? "" : "Loading the pull request…") color="sy.ink3" font-size=13
        if d.timeline.length > 0
          column gap=6
            text "TIMELINE" font-size=12 letter-spacing="0.08em" color="sy.ink3"
            for t, i in d.timeline key=i
              row gap=12
                text t.ago width=110 font-size=12 color="sy.ink4"
                text t.phase font-size=12 color="sy.ink2"
                text t.note font-size=12 color="sy.ink3"
        if d.commits.length > 0
          column gap=6
            text "COMMITS" font-size=12 letter-spacing="0.08em" color="sy.ink3"
            for c in d.commits key=c.sha
              button press=open(`/commit/${c.repo}/${c.sha}`) testId=`pr-commit-${c.short}` appearance="none" width="100%" align-items="stretch" text-align="left" padding="6px 8px" border-radius=6
                row gap=12 align-items="center"
                  column width=8 height=8 border-radius=4 background-color=(c.ci == "failure" or c.ci == "error" ? "sy.red" : (c.ci == "running" or c.ci == "pending" ? "sy.amber" : "sy.ink2"))
                  text c.short font-size=12 color="sy.ink3" width=64
                  text c.title font-size=12 color="sy.ink2" flex=1 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  text c.ago font-size=11 color="sy.ink4"
        if d.pipelines.length > 0
          column gap=6
            text "PIPELINES" font-size=12 letter-spacing="0.08em" color="sy.ink3"
            for p, i in d.pipelines key=i
              row gap=12
                text `#${p.number}` width=70 font-size=12 color="sy.ink2"
                text p.lane width=90 font-size=12 color="sy.ink3"
                text p.state width=80 font-size=12 color=(p.state == "failure" ? "sy.red-text" : (p.state == "running" ? "sy.amber-text" : "sy.ink3"))
                text `${p.dur} · ${p.sha} · ${p.ago}` font-size=12 color="sy.ink4"
