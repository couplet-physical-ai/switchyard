// The web's update: the server serves the newest web build at its own origin, so a page left
// open across a deploy offers a reload (it compares the build it is with /api/v1/meta's web.sha
// every few minutes). Native builds and dev builds (no build sha) never show it.

use WebVer from "./shapes.contract"

members App
  state webTick = 0
  resource webVer = webVersion(webTick) as shape WebVer else empty(stale=false, served="")
  task webPoll mount
    every(300000, webCheck)
  action webCheck
    webTick = webTick + 1
  action webReload
    reload()

component WebReload
  props
    v: WebVer
    go: action
  view
    if v.stale
      row position="absolute" right=16 bottom=60 align-items="center" gap=8 padding="4px 6px 4px 10px" border-radius=999 border="1px solid sy.edge" background-color="sy.raised" testId="web-reload"
        column width=6 height=6 border-radius=3 background-color="sy.amber"
        text "A new version of Switchyard is out" font-size=11 color="sy.ink2" white-space="nowrap"
        button press=go appearance="none" testId="web-reload-go" padding="1px 6px" border-radius=999
          text "Reload" font-size=11 color="sy.amber-text"
