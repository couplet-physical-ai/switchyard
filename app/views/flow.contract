// The Factory (ZERO.md "FACTORY REDO"): the fleet as one line of work, left to right (sources →
// intake → engines → tests → main lines → deploy → apps), on a fixed floor that fits the window:
// no pan, no zoom, no scroll. What fails drops into the FAILED bin (the last 10m / 30m / 1h /
// 2h, remembered). A press on a crate opens the inspector beside the floor; a press on a
// machine, a red main line or a down app opens its page.
// The floor is one canvas (src/flowfloor/floor.ts); the inspector is this file's.

use Hit from "./shapes.contract"

shape FlLink
  id: string
  label: string
  url: string

shape FlRow
  id: string
  n: string
  text: string
  hot: bool

shape FlLog
  ok: bool
  rows: FlRow[]
  note: string

shape FlDetail
  ok: bool
  id: string
  name: string
  num: string
  kind: string
  branch: string
  title: string
  state: string
  word: string
  step: string
  workflow: string
  meta: string
  links: FlLink[]
  logStep: string
  logWorkflow: string
  logLive: bool
  logFail: bool

members App
  // the FAILED bin's window, remembered on this device
  state flWin = "30m" persist
  // the run the inspector shows ("" for none)
  state flSel = ""
  derive flTick = floor(clockMs / 1000)
  resource flDetail = flowDetail(flSel, (here == "factory" and flSel != "") ? flTick : 0) as shape FlDetail else empty()
  resource flLog = flowLog(flSel, flDetail.logStep, flDetail.logWorkflow, flDetail.logLive ? floor(clockMs / 10000) : 0, flDetail.logFail) as shape FlLog else empty()
  mutation flHit as shape Hit then afterFlHit
  derive flNow = match flHit { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  action flUp(e: PointerEvent)
    send flHit = flowPick(e.offsetX, e.offsetY)
  action afterFlHit
    if flNow.kind == "window"
      flWin = flNow.id
    else if flNow.kind == "failed" or flNow.kind == "run" or flNow.kind == "wait"
      flSel = (flSel == flNow.id) ? "" : flNow.id
    else if flNow.route != ""
      openURL(flNow.route)
    else
      flSel = ""
  action flClose
    flSel = ""
  action flKey(k: string)
    if k == "Escape" and flSel != ""
      preventDefault()
      flSel = ""

fn flTone(s: string): string = s == "fail" ? "sy.red-text" : (s == "run" ? "sy.amber" : (s == "pass" ? "sy.green-ink" : "sy.amber-text"))

// The inspector: what the picked run is, where it stands, its links, its log. Fixed beside the
// floor; it never scrolls (the log shows the decisive line and the lines around it, or the tail).
component FlowInspector
  props
    d: FlDetail
    log: FlLog
    close: action
  view
    column position="absolute" top=0 right=0 bottom=0 width=420 padding="16px 18px" gap=8 background-color="sy.canvas" border-left="1px solid sy.rule" overflow="hidden" font-family="Commit Mono" testId="fl-inspector"
      row gap=8 align-items="baseline"
        text d.name font-size=12 font-weight=700 color="sy.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="fl-name"
        text `${d.num} · ${d.kind}` font-size=11.5 color="sy.ink3" white-space="nowrap"
        row flex=1
        button appearance="none" press=close testId="fl-close" aria-label="Close" height=18 padding="0 5px" border-radius=3 border="1px dashed sy.chip-edge"
          text "close ×" font-size=11 color="#8C8C8E"
      text d.branch font-size=11 color="sy.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      if d.title != ""
        text d.title font-size=11.5 color="sy.ink2" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      text d.word font-size=11.5 color=flTone(d.state) testId="fl-word"
      if d.meta != ""
        text d.meta font-size=11 color="sy.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      row flex-wrap="wrap" gap=4 padding="4px 0 6px"
        for l in d.links key=l.id
          link href=l.url testId=`fl-link-${l.id}` aria-label=`${l.label} (opens in a new tab)` height=18 padding="0 5px" border-radius=3 border="1px dashed sy.chip-edge" display="flex" align-items="center" gap=3 white-space="nowrap" text-decoration="none"
            :hover
              border-color="sy.ink3"
            text l.label font-size=11 color="#8C8C8E"
            text "↗" font-size=10 color="sy.ink3"
      if d.logStep != ""
        row gap=8 align-items="baseline" padding-top=6 border-top="1px solid sy.rule"
          text `log · ${d.logStep}` font-size=11.5 font-weight=700 color="sy.ink" white-space="nowrap" flex-shrink=0
          text log.note font-size=11 color="sy.ink3" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="fl-log-note"
        column gap=1 font-size=10.5 overflow="hidden" min-height=0 flex=1 testId="fl-log"
          for r in log.rows key=r.id
            row gap=6 align-items="baseline" min-width=0
              text r.n color="#6A6A6A" width=34 text-align="end" flex-shrink=0 font-variant-numeric="tabular-nums"
              text (r.hot ? "✕" : " ") color="sy.red" width=10 flex-shrink=0
              text r.text color=(r.hot ? "sy.ink" : "sy.ink2") font-weight=(r.hot ? 700 : 400) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
