// Switchyard: Exowatt's whole delivery system as one living schematic (DESIGN.md).
// app.ts is the data module: the fleet lives there, and the yard's canvases draw from it
// every frame. This file is the chrome around them, the views, the controls and the tests' handles.

use NowView from "./views/now.contract"
use FlowInspector from "./views/flow.contract"
use F3Inspector from "./views/factory3.contract"
use UpdatePill from "./views/update.contract"
use Conn, Tok, Ack, Feed, Overview, Hit, Media, Time, Found, Link from "./views/shapes.contract"
use WebReload from "./views/webreload.contract"
use TokenCard from "./views/token.contract"

font "Commit Mono"
  400 = "assets/fonts/CommitMono-400.ttf"
  700 = "assets/fonts/CommitMono-700.ttf"

routes nav
  now "/"
  factory "/factory"
  yard "/yard"
  connect "/connect"

style Field
  ::placeholder
    color="#8A8A8A"

style Primary
  appearance="none"
  padding="6px 14px"
  border-radius=6
  border="1px solid sy.brand"
  background-color="sy.brand"
  color="#0E0E0E"
  font-size=12
  font-weight=700

style Quiet
  appearance="none"
  padding="6px 12px"
  border-radius=6
  border="1px solid sy.edge"
  background-color="sy.control"
  color="sy.ink2"
  font-size=12

style Mono
  font-family="Commit Mono"

component App
  resource media = exactViewport() as shape Media
  resource time = exactTime() as shape Time
  // Where the data comes from: "" is the page's own server (web) or unset (macOS); "demo" is
  // the built-in simulation. The token lives in the app's module (a 0600 file on macOS, the
  // page's localStorage on the web; README "Security"), never in state.
  state server = "" persist
  state draftServer = ""
  state draftToken = ""
  state gen = 0
  state tokGen = 0
  // The clock: `clockMs` moves with every tick (the timers' second among them); `ovClock` only
  // with the ticks that ask the overview (the busy pulse, a wake, the stream's frames, a tab).
  state clockMs = 0
  state ovClock = 0
  state mode = "live"
  state speed = 1
  state q = ""
  state retries = 0
  // p5-board: the stream's own generation. A dropped or refused stream opens again with it, the
  // fleet kept (`retry`); only a failed connect or a reset (a gap) fetches the snapshot again (gen).
  state fgen = 0
  state palSel = 0
  state picked = ""
  state facWheel = 0
  state facPulse = 0
  // fx-kc: the token is read once, async, through the module: the window and the floor never
  // wait on it (a Keychain prompt from an older build's item waits with the window up). The
  // route's ?keychain=denied is the agent's test hook (one read answers denied); ?keychain=left
  // says an old Keychain item was left (Settings' Security note).
  resource tok = loadToken(tokGen, searchParam(top(nav), "keychain")) as shape Tok else empty(ver="", has=false, status="loading", detail="", left=false)
  state tokSlow = false
  resource link = parseLink(searchParam(top(nav), "u"), searchParam(top(nav), "server"), searchParam(top(nav), "token")) as shape Link else empty(server="", token="", ok=false, view="")
  // fx-kc: asked again when the token's read fails or recovers (tokBad), not for each status
  derive tokBad = tok.status == "denied" or tok.status == "error"
  resource conn = connect(server, tok.ver, gen) with time.epochAtZero, time.utcOffset, tokBad as shape Conn else empty(ok=false, status="connecting", error="", seq=0, label="", kind="", needsSetup=false, signIn="")
  resource feed = liveFeed(server, tok.ver, conn.seq, gen, conn.ok, fgen) as shape Feed else empty(ok=false, status="idle", wake=0)
  // (asked again by the clock only while busy (ov.pace 0) or at a wake; by the stream's frames
  // through `fed`; by the view on top, and by the older floors being on top (the web's))
  resource ov = overview(ovClock, conn.seq, conn.ok, ovTop) as shape Overview else empty()
  // What the canvases and Live redraw on: ov.tick (what they show changed: the fleet, the view,
  // the minute) and, while a shown timer runs (ov.pace 1), the second
  derive rk = ov.pace == 1 ? ov.tick * 1000000 + floor(clockMs / 1000) % 1000000 : ov.tick
  // the clock the timers' sources read while only the second ticks (else 0: ov's asks advance it)
  derive tickMs = ov.pace == 1 ? clockMs : 0
  // (asked again when the query changes or the palette opens; never on the clock, and not for each
  // of the stream's frames while nothing shows it: its empty query sorts the whole fleet)
  state palGen = 0
  resource found = search(q, palGen) as shape Found else empty(hits=[])
  mutation ctl as shape Ack refreshes ov
  mutation replayed as shape Ack refreshes ov then afterReplay
  mutation hit as shape Hit refreshes ov then afterHit
  mutation hov as shape Hit
  mutation fac as shape Hit refreshes ov then afterFac
  mutation saved as shape Ack then afterSave
  derive reduced = media.prefersReducedMotion
  derive here = top(nav).name
  resource topView = viewOnTop(here) as shape Ack else empty(ok=false, status="")
  derive dropped = feed.status == "closed" or feed.status == "error" or conn.status == "offline"
  // fx-kc: the token card over the floor, while the server is not connected (the demo and the
  // page's own server never wait on the token): macOS asking about the Keychain (after ~400 ms
  // of waiting, or at once after "Try again"; the module is the macOS one where the updater is),
  // or a read that was denied or failed
  state tokRetrying = false
  // loading: the read is out. pending(tok), not only its value: the build bakes the answer a
  // module-less bake gets ("none") as the first frame's, which stands until the read lands.
  derive tokLoading = pending(tok) or tok.status == "loading"
  derive tokState = (tokLoading or tokRetrying) ? "loading" : tok.status
  derive tokCard = not conn.ok and ((tokState == "loading" and (tokSlow or tokRetrying) and upd.supported) or tokState == "denied" or tokState == "error")
  derive hitNow = match hit { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  derive replayOk = match replayed { case some(r) => r.ok, case none => false }
  // fx-day: a replay's answer says its speed (60 the hour, 720 the day; a resumed one its own)
  derive replaySpeed = match replayed { case some(r) => (match parseNumber(r.status) { case some(n) => n, case none => 60 }), case none => 60 }
  derive hovering = match hov { case some(h) => h.kind != "", case none => false }
  // the yard's lens: what the pointer is over and where (redrawn as it moves; at rest, still)
  derive hovAt = match hov { case some(h) => (h.kind != "" ? `${h.id}@${h.route}` : ""), case none => "" }
  // the Factory (FACTORY3.md): the berth board; the square swarm stays at /factory?v=2 and the
  // old floor at /factory?v=1 for now
  // macOS never mounts the two older floors (they animate every frame): ?v=1 and ?v=2 are the
  // board there (`hostKind`: the native data module answers ok; the web keeps both floors)
  resource host = hostKind() as shape Ack else empty(ok=false, status="")
  derive oldFloors = not host.ok
  derive facV2 = here == "factory" and searchParam(top(nav), "v") == "2" and oldFloors
  derive facV3 = here == "factory" and (searchParam(top(nav), "v") != "1" or not oldFloors) and not facV2
  derive facNow = match fac { case some(h) => h, case none => Hit(kind="", id="", label="", route="") }
  // fab-lens: the coffee check (src/factory/coffee.ts). The last visit per server, kept as the
  // server is: marked once 20 s of looking at the floor count as a visit (fab-w4, §E), every
  // minute after, and on leaving it.
  state visits = "" persist
  state looking = false
  state visitN = 0
  state visitTry = 0
  mutation visit as shape Ack then afterVisit
  // fab-w2/W4: the hourly baseline ring (src/factory/agg/baseline.ts), ≤ 6 KB, kept like visits:
  // bound once at launch, saved through the visit mark (every minute while looking)
  state facBase = "" persist
  resource baseBind = baselineBind(facBase) as shape Ack else empty(ok=false, status="")
  mutation baseSave as shape Ack then afterBase
  derive baseNow = match baseSave { case some(v) => v.status, case none => "" }
  derive visitNow = match visit { case some(v) => v.status, case none => "" }
  // fx-glance: the coffee header's totals (as drawn) are the status line's, word for word
  derive headAgrees = ov.facHead != "" and ov.facHead == `${ov.red} red · ${ov.building} building · ${ov.queued} queued · ${ov.appsDown} down`
  // (the old floor's alone: asked only while it is on top; elsewhere it fetches nothing)
  derive facV1 = here == "factory" and not facV2 and not facV3
  derive ovTop = (facV1 or facV2) ? `${here}~old` : here
  resource coffee = coffeeOpen(server, visits, conn.seq, conn.ok and facV1, facV1 ? ov.tick : 0) as shape Ack else empty(ok=false, status="")
  members "./views/now.contract"
  members "./views/flow.contract"
  members "./views/factory3.contract"
  members "./views/webreload.contract"
  members "./views/update.contract"
  members "./views/hooks.contract"

  // The clock (mac-perf, "idle = still"): 4 times a second while something moves or plays
  // (ov.pace 0: the demo, a replay, playing behind, the HUD, the older floors; and until the
  // token file's connect is reported). While a timer on top runs (ov.pace 1), once a second,
  // and that tick asks nothing but what shows a timer (rk, tickMs). Else no pulse at all: the
  // stream's frames wake the clock (`fed`), and a few wakes a minute turn the minute (ages, hh:mm;
  // a ladder of one-shot timers to the minute's turn, ov.wake; one second after a change, to
  // see what it started).
  derive tfWaits = tfUsed and not tfReported
  task pulse when ov.pace == 0 or tfWaits
    every(250, tick)
  task pulseSec when ov.pace == 1 and not tfWaits
    every(1000, tickSec)
  // (250 ms: frames that keep coming, at 10× or in a burst, are taken in at most 4 times a second,
  // as the old pulse did; a lone frame shows within a quarter second)
  task fed when feed.wake > 0 key=`${feed.wake}`
    after(250, tick)
  task wake1 when ov.pace != 0 and ov.wake == 1 key=ov.wakeKey
    after(1000, tick)
  task wake2 when ov.pace != 0 and ov.wake == 2 key=ov.wakeKey
    after(2000, tick)
  task wake4 when ov.pace != 0 and ov.wake == 4 key=ov.wakeKey
    after(4000, tick)
  task wake8 when ov.pace != 0 and ov.wake == 8 key=ov.wakeKey
    after(8000, tick)
  task wake16 when ov.pace != 0 and ov.wake == 16 key=ov.wakeKey
    after(16000, tick)
  task wake32 when ov.pace != 0 and ov.wake == 32 key=ov.wakeKey
    after(32000, tick)
  // (a view link that still reaches /connect, e.g. one typed by hand on the web: left at once;
  // keyed by the visit, so the same view twice is followed twice)
  task linkView when here == "connect" and link.view != "" key=`${top(nav).id}|${link.view}`
    after(1, openLinkView)
  task tokWait when tokLoading and not tokSlow
    after(400, tokWaited)
  task tokCalm when tokSlow and not tokLoading and not tokRetrying
    after(1, tokSlowOff)
  task tokRetried when tokRetrying and not pending(tok)
    after(1, tokRetryDone)
  // The factory floor's calm clock: while it is on top and calm, its live layer (asleep when
  // nothing travels) is woken 8 times a second for the belts and the beat (src/factory/motion.ts);
  // a loud floor draws every frame on its own, so the clock stops.
  task facBeat when here == "factory" and not facV2 and not facV3 and ov.facCalm
    every(125, facPulseTick)
  // A dropped stream, or one the server refused, opens again after 2, 4, 8, 16, then every 30 s,
  // and never sooner: it resumes after the last frame it brought (`since`), the fleet kept (no
  // snapshot, no rebuilt rows). A failed connect asks the snapshot again on the same ladder. A
  // reset (a gap, or a resume the server can no longer serve) refetches the snapshot at once. A
  // stream live for 20 s starts the ladder over.
  task resync when feed.status == "reset" key=`${retries}`
    after(250, refetch)
  task reconnect0 when dropped and retries == 0
    after(2000, retry)
  task reconnect1 when dropped and retries == 1
    after(4000, retry)
  task reconnect2 when dropped and retries == 2
    after(8000, retry)
  task reconnect3 when dropped and retries == 3
    after(16000, retry)
  task reconnect4 when dropped and retries >= 4 key=`${retries}`
    after(30000, retry)
  task steady when feed.status == "live" and retries > 0
    after(20000, steadyAgain)
  // fab-lens: the coffee check's last visit (the old floor's, /factory?v=1 on the web: the board
  // and the Yard never show it, so they mark nothing each minute)
  task coffeeLook when conn.ok and facV1 and not looking key=server
    after(20000, startLooking)
  task coffeeAgain when looking and facV1 and visitTry > 0 key=`${visitTry}`
    after(60000, markVisit)
  task coffeeLeave when looking and not facV1
    after(1, leaveFactory)

  action tick
    let t = performanceNow()
    clockMs = t
    ovClock = t
  // a shown timer's second: the overview is not asked
  action tickSec
    clockMs = performanceNow()
  action tokWaited
    tokSlow = true
  action tokSlowOff
    tokSlow = false
  // fx-kc: the token card's buttons: read again, or type one in Settings
  action tokRetry
    tokRetrying = true
    tokGen = tokGen + 1
  action tokRetryDone
    tokRetrying = false
  action tokEnter
    openSettings()
  // Sign out: the token file goes (and the old Keychain item's delete is tried); then reconnect
  action forgetToken
    draftToken = ""
    send saved = forgetToken()
  action facPulseTick
    facPulse = facPulse + 1
  action retry
    retries = retries + 1
    if conn.ok
      fgen = fgen + 1
    else
      gen = gen + 1
  action refetch
    retries = retries + 1
    gen = gen + 1
  action steadyAgain
    retries = 0
  action startLooking
    looking = true
    markVisit()
  action markVisit
    visitTry = visitTry + 1
    send visit = coffeeMark(server, visits)
    send baseSave = baselineSave()
  action leaveFactory
    looking = false
    markVisit()
  action afterBase
    if baseNow != ""
      facBase = baseNow
  action afterVisit
    if visitNow != ""
      visits = visitNow
      visitN = visitN + 1
  // (a new view on top reads the clock now: the pulse may have been asleep)
  // A switchyard://view/<live|factory|yard> link (the system hands it over as /connect?u=<the URL>)
  // switches the tab right here, in the action: no /connect screen, no resource to wait for, so a
  // link that lands while the fleet connects or loads (or on the view already on top) is never
  // left on /connect (sy-ship's 0.1.7 soak: a link 1 s after connect stayed there). Anything else
  // (a connect link, another location) goes as before.
  action follow(url: string)
    tick()
    let u = url.startsWith("/connect?") ? searchParam(top(push(nav, url)), "u") : ""
    let t = u.startsWith("switchyard://view/") ? u.slice(18) : ""
    let t2 = t.indexOf("?") >= 0 ? t.slice(0, t.indexOf("?")) : t
    let v = t2.indexOf("/") >= 0 ? t2.slice(0, t2.indexOf("/")) : t2
    if v == "live" or v == "now"
      nav = go(nav, "/")
    else if v == "factory"
      nav = go(nav, "/factory")
    else if v == "yard"
      nav = go(nav, "/yard")
    else
      nav = go(nav, url)
  action back
    tick()
    nav = back(nav)
  action goTo(name: string)
    tick()
    nav = go(nav, name == "now" ? "/" : `/${name}`)

  // Time controls (DESIGN.md, "Time")
  action pause
    mode = "paused"
    send ctl = timeControl("pause", speed)
  action playAt(s: number)
    speed = s
    mode = (s == 1 and (mode == "live" or mode == "replay")) ? mode : "behind"
    send ctl = timeControl("play", s)
  action goLive
    mode = "live"
    speed = 1
    send ctl = timeControl("live", 1)
  action togglePause
    if mode == "paused"
      // fx-day: a paused replay goes on at its speed (afterReplay); else 1× behind live
      speed = 1
      mode = "behind"
      send replayed = replayResume(clockMs)
    else
      mode = "paused"
      send ctl = timeControl("pause", speed)
  action startReplay
    send replayed = replayHour(clockMs)
  // fx-day: the last 24 h in 2 min (DAY_SPEED, app.ts), then live
  action startDay
    send replayed = replayDay(clockMs)
  action afterReplay
    if replayOk
      mode = "replay"
      speed = replaySpeed

  // The yard: a press picks what is under it; the pointer over it promotes what is under it
  // to full detail (a lens); leaving the canvas lets the lens go.
  action pressYard(e: PointerEvent)
    send hit = pickAt(e.offsetX, e.offsetY)
  action moveYard(e: PointerEvent)
    send hov = hoverAt(e.offsetX, e.offsetY)
  action leaveYard
    if hovering
      send hov = hoverAt(-1, -1)
    // (Factory 3's board lets go of what the pointer was over, the same way)
    if f3Over.label != ""
      send f3Hov = f3Pick(-1, -1)

  // The factory floor: drag pans, the wheel zooms, a click picks (a crate lights its journey)
  action facDown(e: PointerEvent)
    send fac = facPointer("down", e.offsetX, e.offsetY, e.buttons)
  action facMove(e: PointerEvent)
    send fac = facPointer("move", e.offsetX, e.offsetY, e.buttons)
  action facUp(e: PointerEvent)
    send fac = facPointer("up", e.offsetX, e.offsetY, e.buttons + (e.shiftKey ? 256 : 0))
  // fab-lens: Esc / ⌫ walk back up the lens stack, ? shows the key
  action facKey(k: string)
    if k == "Escape" or k == "Backspace" or k == "?" or k == "s" or k == "S" or k == "w" or k == "W"
      preventDefault()
      send fac = facPointer(`key:${k}`, 0, 0, 0)
  action facWheeled(e: WheelEvent)
    facWheel = facWheel + e.deltaY
    preventDefault()
  action afterFac
    if facNow.kind == "replay"
      startReplay()
    else if facNow.kind == "replay24"
      startDay()
    else if facNow.kind == "replayAt"
      send replayed = replayAt(clockMs, facNow.id)
    else if facNow.kind == "live"
      goLive()

  // Developer: the HUD (⌘⇧D) and stress mode (a 10× synthetic fleet for the renderer)
  action toggleHud
    send ctl = devToggle("hud", ov.hud ? 0 : 1)
  action toggleStress
    send ctl = devToggle("stress", ov.stress ? 0 : 1)
  action afterHit
    if hitNow.kind == "replay"
      startReplay()
    else if hitNow.kind == "repo"
      picked = hitNow.id
      nav = go(nav, path("now") + `?repo=${encodeURIComponent(hitNow.id)}`)
    else if hitNow.kind == "pipeline"
      picked = hitNow.id
    else if hitNow.kind == "view"
      goTo("now")
    else if hitNow.kind == "app"
      nav = go(nav, path("now") + `?app=${encodeURIComponent(hitNow.id)}`)
    else if hitNow.kind == "commit"
      nav = go(nav, hitNow.route)

  // ⌘K
  action openPalette
    q = ""
    palGen = palGen + 1
    showModal("palette")
  action typed(v: string)
    q = v
    palSel = 0
  action palKey(k: string)
    if k == "ArrowDown"
      preventDefault()
      palSel = palSel + 1 < found.hits.length ? palSel + 1 : palSel
    else if k == "ArrowUp"
      preventDefault()
      palSel = palSel > 0 ? palSel - 1 : 0
    else if k == "Enter"
      preventDefault()
      match found.hits.at(palSel)
        case some(h)
          nav = go(nav, h.route)
          close("palette")
        case none
          palSel = 0
  action openHit(route: string)
    nav = go(nav, route)

  // Settings and the switchyard:// link
  action openSettings
    draftServer = server
    draftToken = ""
    showModal("settings")
  action editServer(v: string)
    draftServer = v
  action editToken(v: string)
    draftToken = v
  action saveSettings
    server = draftServer.trim()
    send saved = saveToken(draftToken, draftToken != "")
  action useDemo
    server = "demo"
    gen = gen + 1
  action afterSave
    tokGen = tokGen + 1
    gen = gen + 1
  action openLinkView
    tick()
    nav = go(back(nav), link.view)
  action connectLink
    server = link.server
    send saved = saveToken(link.token, link.token != "")
    nav = go(nav, "/")

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="root" width="100%" height="100%" background-color="sy.canvas" color="sy.ink" font-family="Commit Mono" -exact-menu-remove="show-tab-bar" pointermove=leaveYard
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column"
          TopBar(here=e.name, goTo=goTo, openPalette=openPalette)
          if e.name == "now"
            column flex=1 min-height=0 position="relative"
              NowView(d=nowData, p=nowPanelData, log=nowLogData, sel=nowSel, open=nowOpen, mode=ov.mode, reduced=reduced, calm=(here != "now" or ov.mode == "paused"), t=nowTickData, narrow=nowNarrow, compact=nowCompact, tight=nowTight, more=nowMore, rows=nowRows, select=nowSelect, expand=nowExpand, close=nowClose, only=nowFilter, clear=nowClear, key=nowKey, toggleMore=nowToggleMore, settings=openSettings)
              if tokCard
                TokenCard(status=tokState, detail=tok.detail, retry=tokRetry, enter=tokEnter)
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 align-items="center" justify-content="center" background-color="sy.canvas" gap=14 testId="now-setup"
                  text (conn.needsSetup ? "Connect Switchyard to a server" : "The server is not answering") font-weight=700 font-size=16
                  text (conn.error != "" ? conn.error : "Its address and a token, or watch the built-in demo fleet.") color="sy.ink3" font-size=13 max-width=560 text-align="center" testId="now-setup-error"
                  row gap=10
                    if conn.signIn != ""
                      link href=conn.signIn class=Primary testId="now-setup-signin"
                        text "Sign in on the web…"
                    button press=openSettings class=(conn.signIn != "" ? Quiet : Primary) testId="now-setup-connect"
                      text (conn.signIn != "" ? "Use a token…" : "Connect…")
                    button press=useDemo testId="now-setup-demo" class=Quiet
                      text "Watch the demo"
          if e.name == "factory" and facV2
            // The Factory (views/flow.contract, src/flowfloor/): one fixed, fitted floor; a press
            // picks (a crate opens the inspector; a machine, a red main line or a down app its page)
            column flex=1 min-height=0 position="relative" testId="factory" key=flKey outline="none"
              column position="absolute" inset=0 testId="factory-floor"
                canvas surface=flowFloor(flWin, flSel, ov.mode, reduced, reduced ? flTick : 0) position="absolute" left=0 top=0 width="100%" height="100%"
                  tabindex=0 role="img" aria-label=ov.summary pointerup=flUp touch-action="none" testId="factory-live" outline="none"
                  :focus-visible
                    box-shadow="inset 0 0 0 1px #A3A3A3"
              if flSel != "" and flDetail.ok
                FlowInspector(d=flDetail, log=flLog, close=flClose)
              // the replays: the last hour at 60×, the day in two minutes (the demo: its last 2 h)
              row position="absolute" left=16 bottom=12 gap=6
                button appearance="none" press=startReplay testId="replay" aria-label="Replay the last hour, sped up" disabled=(ov.mode == "replay" or not conn.ok)
                  height=18 padding="0 6px" border-radius=3 border="1px dashed sy.chip-edge"
                  text "replay the last hour" font-size=11 color="#8C8C8E"
                button appearance="none" press=startDay testId="replay-day" aria-label="Replay the last 24 hours in two minutes" disabled=(ov.mode == "replay" or not conn.ok)
                  height=18 padding="0 6px" border-radius=3 border="1px dashed sy.chip-edge"
                  text "replay the day" font-size=11 color="#8C8C8E"
              // Offline or not set up: a card over the floor (the idle floor, or the last fleet
              // it showed, dimmed behind it), never a black void.
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 background-color="sy.canvas" opacity=0.7 aria-hidden=true
              if tokCard
                TokenCard(status=tokState, detail=tok.detail, retry=tokRetry, enter=tokEnter)
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 align-items="center" justify-content="center" testId="setup"
                  column align-items="center" gap=14 padding="26px 32px" border-radius=12 border="1px solid sy.edge" background-color="sy.raised" max-width=620
                    text (conn.needsSetup ? "Connect Switchyard to a server" : "The server is not answering") font-weight=700 font-size=16
                    text (conn.error != "" ? conn.error : "Its address and a token, or watch the built-in demo fleet.") color="sy.ink3" font-size=13 max-width=560 text-align="center" testId="setup-error"
                    row gap=10
                      if conn.signIn != ""
                        link href=conn.signIn class=Primary testId="setup-signin"
                          text "Sign in on the web…"
                      button press=openSettings class=(conn.signIn != "" ? Quiet : Primary) testId="setup-connect"
                        text (conn.signIn != "" ? "Use a token…" : "Connect…")
                      button press=useDemo testId="setup-demo" class=Quiet
                        text "Watch the demo"
          if e.name == "factory" and facV3
            // Factory 3 (views/factory3.contract, src/factory3/): the berth board. Two canvases:
            // the marks and words (repainted only when they change) and the squares in transit.
            column flex=1 min-height=0 position="relative" testId="factory" key=f3Key outline="none" pointermove=f3Leave
              column position="absolute" inset=0 testId="factory-floor"
                canvas surface=f3Board(f3Win, f3Sel, ov.mode, reduced, f3Dock, f3Over.label, rk) position="absolute" left=0 top=0 width="100%" height="100%"
                  tabindex=0 role="img" aria-label=ov.summary pointerup=f3Up pointermove=f3Move touch-action="none" testId="factory-live" outline="none" cursor=(f3Over.label != "" ? "pointer" : "default")
                  :focus-visible
                    box-shadow="inset 0 0 0 1px #A3A3A3"
                canvas surface=f3Live(rk) position="absolute" left=0 top=0 width="100%" height="100%" pointer-events="none" aria-hidden=true testId="factory-moving"
              if f3Dock
                F3Inspector(d=f3D, log=f3L, close=f3Close)
              // the developer HUD (the status line's "hud"): what the board painted
              if ov.hud
                text f3S.work position="absolute" left=16 bottom=4 font-size=10 color="sy.ink3" pointer-events="none" testId="f3-hud"
              // the last hour at 60× (real events, replayed): the Yard's dial, as words
              button appearance="none" press=startReplay testId="replay" aria-label="Replay the last hour, sped up" disabled=(ov.mode == "replay" or not conn.ok)
                position="absolute" right=16 top=18 height=18 padding="0 6px" border-radius=3 border="1px solid sy.edge"
                text "replay the last hour" font-size=11 color="sy.ink3"
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 background-color="sy.canvas" opacity=0.7 aria-hidden=true
              if tokCard
                TokenCard(status=tokState, detail=tok.detail, retry=tokRetry, enter=tokEnter)
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 align-items="center" justify-content="center" testId="setup"
                  column align-items="center" gap=14 padding="26px 32px" border-radius=12 border="1px solid sy.edge" background-color="sy.raised" max-width=620
                    text (conn.needsSetup ? "Connect Switchyard to a server" : "The server is not answering") font-weight=700 font-size=16
                    text (conn.error != "" ? conn.error : "Its address and a token, or watch the built-in demo fleet.") color="sy.ink3" font-size=13 max-width=560 text-align="center" testId="setup-error"
                    row gap=10
                      if conn.signIn != ""
                        link href=conn.signIn class=Primary testId="setup-signin"
                          text "Sign in on the web…"
                      button press=openSettings class=(conn.signIn != "" ? Quiet : Primary) testId="setup-connect"
                        text (conn.signIn != "" ? "Use a token…" : "Connect…")
                      button press=useDemo testId="setup-demo" class=Quiet
                        text "Watch the demo"
          if e.name == "factory" and not facV2 and not facV3
            column flex=1 min-height=0 position="relative" testId="factory" key=facKey outline="none"
              // fab-lens: the coffee check's glance in words (the canvas draws it)
              text coffee.status position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" opacity=0 testId="coffee"
              canvas surface=factoryFloor(ov.facKey, facNow.route, facWheel) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="factory-floor"
              canvas surface=factoryLive(reduced ? "reduced" : "full", facNow.route, facWheel, facPulse) position="absolute" left=0 top=0 width="100%" height="100%"
                tabindex=0 role="img" aria-label=ov.summary pointerdown=facDown pointermove=facMove pointerup=facUp wheel=facWheeled key=facKey touch-action="none" testId="factory-live" outline="none"
                // w2-chrome (REVIEW-iter3 #8): no orange frame after a key press (Esc walks the lens
                // stack); a keyboard focus is a 1-px inset in ink2 at the canvas's edges
                :focus-visible
                  box-shadow="inset 0 0 0 1px #A3A3A3"
              canvas surface=factoryTop(reduced ? "reduced" : "full", facNow.route, facWheel, facPulse) position="absolute" left=0 top=0 width="100%" height="100%" pointer-events="none" aria-hidden=true testId="factory-top"
              // The strip's "last hour at 60×" (the canvas draws its words) is this button too: its press
              // for tests and keyboards, laid over the drawn words (a fully transparent button is
              // still a target on every host, an opacity 0 one is not on macOS). fx-glance: the strip
              // starts with it now ("live" is the status line's one control).
              button appearance="none" press=startReplay testId="replay" aria-label="Replay the last hour, sped up" disabled=(ov.mode == "replay" or not conn.ok)
                position="absolute" bottom=17 left=18 width=160 height=28 background-color="transparent" padding=0
                text "last hour" color="#00000000" font-size=1
              // fx-day: and beside it the day's, "24 h in 2 min" (the demo's: "2 h at 120×", its last 2 h)
              button appearance="none" press=startDay testId="replay-day" aria-label="Replay the last 24 hours in two minutes" disabled=(ov.mode == "replay" or not conn.ok)
                position="absolute" bottom=17 left=180 width=130 height=28 background-color="transparent" padding=0
                text "24 h" color="#00000000" font-size=1
              // Offline or not set up: a card over the floor (the idle floor, or the last fleet
              // it showed, dimmed behind it), never a black void.
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 background-color="sy.canvas" opacity=0.7 aria-hidden=true
              if tokCard
                TokenCard(status=tokState, detail=tok.detail, retry=tokRetry, enter=tokEnter)
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 align-items="center" justify-content="center" testId="setup"
                  column align-items="center" gap=14 padding="26px 32px" border-radius=12 border="1px solid sy.edge" background-color="sy.raised" max-width=620
                    text (conn.needsSetup ? "Connect Switchyard to a server" : "The server is not answering") font-weight=700 font-size=16
                    text (conn.error != "" ? conn.error : "Its address and a token, or watch the built-in demo fleet.") color="sy.ink3" font-size=13 max-width=560 text-align="center" testId="setup-error"
                    row gap=10
                      if conn.signIn != ""
                        link href=conn.signIn class=Primary testId="setup-signin"
                          text "Sign in on the web…"
                      button press=openSettings class=(conn.signIn != "" ? Quiet : Primary) testId="setup-connect"
                        text (conn.signIn != "" ? "Use a token…" : "Connect…")
                      button press=useDemo testId="setup-demo" class=Quiet
                        text "Watch the demo"
          if e.name == "yard"
            column flex=1 min-height=0 position="relative" testId="yard"
              canvas surface=yardStatic(ov.layoutKey, ov.stress) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="yard-static"
              canvas surface=yardInfo(ov.layoutKey, rk) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="yard-info"
              canvas surface=yardLive(reduced ? "reduced" : "full", picked, rk) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="yard-live"
              canvas surface=yardTop(ov.hud, hovAt) position="absolute" left=0 top=0 width="100%" height="100%"
                role="img" aria-label=ov.summary pointerdown=pressYard pointermove=moveYard touch-action="none" testId="yard-top"
              // The dial is the replay: the canvas draws its face, this button is its words and its press.
              button appearance="none" press=startReplay testId="yard-replay" aria-label="Replay the last hour, sped up" disabled=(ov.mode == "replay" or not conn.ok)
                position="absolute" top=0 right=0 height=(ov.dialH > 0 ? ov.dialH : 26) padding-left=12 padding-right=(ov.dialPad > 0 ? ov.dialPad : 38) display="flex" align-items="center"
                text (ov.dial != "" ? ov.dial : "1 hour, sped up") font-size=(ov.dialFont > 0 ? ov.dialFont : 11) color=(ov.mode == "replay" or ov.mode == "paused" ? "sy.amber-text" : "sy.ink3")
              if tokCard
                TokenCard(status=tokState, detail=tok.detail, retry=tokRetry, enter=tokEnter)
              if not conn.ok and conn.status != "connecting" and not tokCard
                column position="absolute" inset=0 align-items="center" justify-content="center" background-color="sy.canvas" gap=14 testId="yard-setup"
                  text (conn.needsSetup ? "Connect Switchyard to a server" : "The server is not answering") font-weight=700 font-size=16
                  text (conn.error != "" ? conn.error : "Its address and a token, or watch the built-in demo fleet.") color="sy.ink3" font-size=13 max-width=560 text-align="center" testId="yard-setup-error"
                  row gap=10
                    if conn.signIn != ""
                      link href=conn.signIn class=Primary testId="yard-setup-signin"
                        text "Sign in on the web…"
                    button press=openSettings class=(conn.signIn != "" ? Quiet : Primary) testId="yard-setup-connect"
                      text (conn.signIn != "" ? "Use a token…" : "Connect…")
                    button press=useDemo testId="yard-setup-demo" class=Quiet
                      text "Watch the demo"
          if e.name == "connect"
            column align-items="center" justify-content="center" flex=1 gap=12 testId="connect"
              text (link.ok ? "Connect to this server?" : "This link names no Switchyard server") font-weight=700 font-size=16
              text link.server color="sy.ink2" font-size=13 testId="connect-server"
              if link.ok and link.token != ""
                text "with a device token from the link (kept on this device, for your account only)" color="sy.ink3" font-size=12
              row gap=10
                button press=connectLink disabled=(not link.ok) class=Primary testId="connect-yes"
                  text "Connect"
                button press=back testId="connect-no" class=Quiet
                  text "Cancel"
          // The status line stays unchanged on Factory and Yard.
          if e.name == "factory" or e.name == "yard"
            footer display="flex" align-items="center" gap=8 height=26 padding="0 10px 0 12px" border-top="1px solid sy.rule" testId="timebar"
              row align-items="center" gap=6
                column width=6 height=6 border-radius=3 background-color=(not conn.ok ? "sy.red" : (ov.mode == "live" ? "sy.green" : "sy.amber"))
                text (not conn.ok ? (conn.status == "connecting" ? "connecting" : "offline") : ov.mode) font-size=11 color=(not conn.ok ? "sy.red-text" : (ov.mode == "live" ? "sy.green" : "sy.amber-text")) testId="mode-pill"
              button appearance="none" press=openSettings aria-label="Connection" testId="open-settings" padding="2px 6px" border-radius=5
                text (conn.ok ? ov.host : conn.status) font-size=11 color="sy.ink3" testId="conn-status"
              // fx-glance: on the factory the coffee header says the numbers (one place); the other views keep this
              text (e.name == "factory" ? "" : ov.sentence) color="sy.ink3" font-size=11 flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="sentence"
              if ov.mode != "live"
                button appearance="none" press=goLive testId="go-live" padding="2px 8px" border-radius=5 aria-keyshortcuts="L"
                  text "back to live" color="sy.green" font-size=11
              button appearance="none" press=toggleHud aria-keyshortcuts="Meta+Shift+D" aria-label="Developer HUD" testId="hud-toggle" padding="2px 6px" border-radius=5
                text "hud" font-size=11 color=(ov.hud ? "sy.amber-text" : "sy.ink3")
              button appearance="none" press=togglePause testId="pause" aria-keyshortcuts="Space" padding="2px 10px" border-radius=5 border="1px solid sy.edge" disabled=(not conn.ok)
                text (ov.mode == "paused" ? "Play" : "Pause") font-size=11 color="sy.ink2"
              row role="radiogroup" aria-label="Speed" padding=2 gap=1 border-radius=6 background-color="sy.control"
                button role="radio" appearance="none" aria-checked=(ov.speed == 1 and ov.mode != "paused") press=playAt(1) testId="speed-1" padding="1px 9px" border-radius=4 disabled=(not conn.ok)
                  background-color=(ov.speed == 1 and ov.mode != "paused" ? "sy.control-on" : "transparent")
                  text "1×" font-size=11 color=(ov.speed == 1 and ov.mode != "paused" ? "sy.ink" : "sy.ink3")
                button role="radio" appearance="none" aria-checked=(ov.speed == 0.25 and ov.mode != "paused") press=playAt(0.25) testId="speed-quarter" padding="1px 9px" border-radius=4 disabled=(not conn.ok)
                  background-color=(ov.speed == 0.25 and ov.mode != "paused" ? "sy.control-on" : "transparent")
                  text "¼×" font-size=11 color=(ov.speed == 0.25 and ov.mode != "paused" ? "sy.ink" : "sy.ink3")
      // Over Factory they sit above its strip; Yard's footer keeps its existing spacing.
      WebReload(v=webVer, go=webReload, lift=(top(nav).name == "factory" ? 92 : (top(nav).name == "yard" ? 60 : 16)))
      UpdatePill(u=upd, notesOpen=updNotes, check=checkUpdates, install=installUpdate, toggleNotes=updToggleNotes, lift=(top(nav).name == "factory" ? 92 : (top(nav).name == "yard" ? 60 : 16)))
      dialog id="palette" aria-label="Search" testId="palette" color="sy.ink" width=640 max-width="90vw" padding=0 border-radius=12 background-color="sy.raised" border="1px solid sy.edge"
        column padding=10 gap=6
          input type="text" value=q input=typed key=palKey aria-label="Search" autofocus=true placeholder="repo, #pr, sha, app" testId="palette-input" class=Field
            padding="10px 12px" font-size=15 border-radius=8 background-color="sy.canvas" border="1px solid sy.edge" color="sy.ink"
          list id="palette-results" max-height=420 testId="palette-results"
            for h, i in found.hits key=h.id
              button press=openHit(h.route) commandfor="palette" command="close" testId=`hit-${h.kind}-${h.id}` appearance="none" width="100%" align-items="stretch" text-align="left" padding="8px 10px" border-radius=6
                background-color=(i == palSel ? "sy.control-on" : "transparent") border-left=(i == palSel ? "2px solid sy.brand" : "2px solid transparent") aria-selected=(i == palSel)
                row gap=10 align-items="baseline"
                  text h.kind color="sy.ink3" font-size=11 width=58
                  column gap=2 flex=1 min-width=0
                    text h.title font-size=13 color="sy.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                    text h.subtitle font-size=12 color="sy.ink3"
            if found.hits.length == 0
              text "Nothing matches." color="sy.ink3" font-size=13 padding=10 testId="palette-empty"
      dialog id="settings" aria-label="Connection" testId="settings" color="sy.ink" width=520 max-width="90vw" padding=20 border-radius=12 background-color="sy.raised" border="1px solid sy.edge"
        column gap=12
          text "Connection" role="heading" aria-level=2 font-weight=700 font-size=16
          text (conn.ok ? `${conn.kind == "demo" ? "Watching the built-in demo fleet" : `Connected to ${conn.label}`} · seq ${conn.seq}` : (conn.error != "" ? conn.error : conn.status)) color=(conn.ok ? "sy.ink3" : "sy.red-text") font-size=12 testId="settings-status"
          column gap=6
            text "Server" font-size=12 color="sy.ink3"
            input value=draftServer input=editServer aria-label="Server" placeholder="https://switchyard.apps.example.com" testId="server-field" class=Field
              padding="8px 10px" font-size=13 border-radius=8 background-color="sy.canvas" border="1px solid sy.edge" color="sy.ink"
            text "blank: the server this page came from · demo: the built-in fleet" font-size=11 color="sy.ink3"
          column gap=6
            row align-items="center" gap=8
              text (tok.has ? "Token (one is saved; type to replace it)" : "Token") font-size=12 color="sy.ink3" flex=1
              if tok.has
                button press=forgetToken commandfor="settings" command="close" appearance="none" testId="settings-forget" padding="1px 6px" border-radius=5
                  text "Forget token" font-size=11 color="sy.ink3"
            input type="password" value=draftToken input=editToken aria-label="Token" placeholder="kept on this device, for your account only" testId="token-field" class=Field
              padding="8px 10px" font-size=13 border-radius=8 background-color="sy.canvas" border="1px solid sy.edge" color="sy.ink"
          // fx-kc: an older build's Keychain item that macOS would not let this build delete
          if tok.left
            column gap=4 padding-top=10 border-top="1px solid sy.rule" testId="settings-security"
              text "SECURITY" font-size=10 letter-spacing="0.08em" color="sy.ink3" font-weight=700
              text "An old Switchyard token remains in your login Keychain; remove it in Keychain Access → search 'switchyard'." font-size=12 color="sy.ink2" testId="settings-security-note"
          row gap=8 align-items="center"
            button appearance="none" press=toggleStress testId="settings-stress" padding="4px 10px" border-radius=6 border="1px solid sy.edge"
              text (ov.stress ? "Stress mode: on (10× synthetic fleet)" : "Stress mode: off") font-size=12 color=(ov.stress ? "sy.red-text" : "sy.ink3")
          row gap=10 justify-content="flex-end"
            button press=useDemo commandfor="settings" command="close" testId="settings-demo" class=Quiet
              text "Watch the demo"
            button commandfor="settings" command="close" testId="settings-cancel" class=Quiet
              text "Cancel"
            button press=saveSettings commandfor="settings" command="close" class=Primary testId="settings-save"
              text "Connect"
          // UPDATES (macOS only; views/update.contract): this version, what the updater is doing, the buttons.
          if upd.supported
            column gap=6 padding-top=12 border-top="1px solid sy.rule" testId="update-settings"
              text "UPDATES" font-size=10 letter-spacing="0.08em" color="sy.ink3" font-weight=700
              row align-items="center" gap=10
                column gap=2 flex=1 min-width=0
                  text `Switchyard ${upd.current}` font-size=12 color="sy.ink" testId="update-version"
                  text upd.status font-size=11 color=(upd.state == "error" ? "sy.red-text" : "sy.ink3") testId="update-status"
                if upd.state == "ready"
                  button press=installUpdate class=Primary testId="update-install-settings"
                    text "Relaunch to update"
                button press=checkUpdates class=Quiet testId="update-check-settings" disabled=(upd.state == "checking" or upd.state == "downloading" or upd.state == "installing")
                  text "Check for updates"

component TopBar
  props
    here: string
    goTo: action
    openPalette: action
  view
    header appearance="none" display="flex" align-items="center" gap=2 height=32 padding="0 10px 0 14px" border-bottom="1px solid sy.rule" testId="topbar"
      row align-items="center" gap=8 margin-right=14
        svg width=14 height=14 viewBox="0 0 24 24" aria-hidden=true
          circle cx=12 cy=12 r=10 fill="none" stroke="sy.ink" stroke-width=2
          path d="M5 12a7 7 0 0 1 14 0M8.5 12a3.5 3.5 0 0 1 7 0" fill="none" stroke="sy.brand" stroke-width=2 stroke-linecap="round"
        text "switchyard" role="heading" aria-level=1 font-weight=700 font-size=13 letter-spacing="0.02em"
      row role="tablist" appearance="none" aria-label="Views" gap=1
        for v in ["now", "factory", "yard"] key=v
          button role="tab" appearance="none" aria-selected=(here == v) press=goTo(v) testId=`tab-${v}` aria-keyshortcuts=`Meta+${v == "now" ? "1" : v == "factory" ? "2" : "3"}`
            padding="3px 9px" border-radius=5 background-color=(here == v ? "sy.control" : "transparent")
            text (v == "now" ? "Live" : (v == "factory" ? "Factory" : "Yard")) color=(here == v ? "sy.ink" : "sy.ink3") font-size=12
      row flex=1
      button appearance="none" press=openPalette aria-keyshortcuts="Meta+K" aria-label="Search" testId="open-palette"
        padding="3px 9px" border-radius=5 border="1px solid sy.edge" min-width=0 flex-shrink=1
        row gap=16 align-items="center" min-width=0
          text "search repos, prs, commits" color="sy.ink3" font-size=11 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
          text "⌘K" color="sy.ink3" font-size=11
